/*
 * beekeeb Toucan (dongle mode) keymap
 *
 * GENERATED by keyboard-manager from beekeeb 36key.vil — do not hand-edit if you
 * intend to regenerate. Change the layout in Vial, re-export, and diff.
 *
 * Read CONVERSION-REPORT.md first: it lists everything that did not map
 * cleanly from QMK to ZMK.
 */

#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
/* 左半改當 split central 之後才需要的：主機配對與輸出切換都歸鍵盤自己管。 */
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * 鍵盤上的滑鼠鍵每一步的量。這裡只管「用鍵盤推游標 / 滾輪」，
 * 觸控板本身的速度在 boards/shields/toucan/toucan.dtsi 的 PAD_* 那組。
 */
#define KB_SCRL  50   /* &msc 每步的捲動量，ZMK 預設 10 */
#define KB_MOVE 600   /* &mmv 每步的游標移動量，ZMK 預設 600 */

/*
 * MOUSE (6) 與 SCROLL (7) 共用的 42 格 bindings。
 *
 * 兩層除了六顆拇指之外完全相同——6 的拇指指向游標三檔 (8/9/10)，
 * 7 的指向滾動三檔 (11/12/13)。兩個 layer index 不能合併：input-listener
 * 只認 layer，合併之後觸控板自動升層時就會變成滾動、游標永遠動不了。
 * 也不能讓 7 去 hold 6——ZMK 的 layer state 是沒有 reference counting 的
 * 共用 bitmask，temp-layer 的 timeout 會跟手動 hold 互相打架。
 *
 * 位置 10 (P) 是 &to 0：&to 會把目標層以上的所有層一併關掉，所以它同時
 * 也是「解除速度鎖定」的逃生口。
 *
 * 拇指 36-41 全部在 toucan.dtsi 的 excluded-positions 名單裡，動之前先看那邊。
 */
#define PAD_BINDINGS(T36, T37, T38, T39, T40, T41)                                            \
    &trans  &kp LG(W)  &msc MOVE_Y(KB_SCRL)  &mmv MOVE_Y(-KB_MOVE)  &msc MOVE_Y(-KB_SCRL)     \
    &trans  &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))                               \
    &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &to 0  &trans                                \
    &trans  &msc MOVE_X(KB_SCRL)  &mmv MOVE_X(-KB_MOVE)  &mmv MOVE_Y(KB_MOVE)                 \
    &mmv MOVE_X(KB_MOVE)  &msc MOVE_X(-KB_SCRL)  &msc MOVE_X(KB_SCRL)                         \
    &msc MOVE_Y(KB_SCRL)  &msc MOVE_Y(-KB_SCRL)  &msc MOVE_X(-KB_SCRL)  &trans  &trans        \
    &trans  &kp LS(LG(T))  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans                            \
    &kp END  &kp PAGE_DOWN  &kp PAGE_UP  &kp HOME  &trans  &trans                             \
    T36  T37  T38  T39  T40  T41

/*
 * Hold-tap feel, carried over from the .vil's QMK settings.
 *   tapping-term-ms — Vial "Tapping Term"
 *   flavor          — derived from Vial's permissive-hold / mod-tap-interrupt
 *                     flags. If home-row mods misfire, this is the knob:
 *                     "tap-preferred" is the most forgiving, "hold-preferred"
 *                     the most eager. See zmk.dev/docs/keymaps/behaviors/hold-tap
 */

&msc {
    // 每次滾動訊號送出的間隔時間 (預設通常是 10 或 15)
    // 數字越小 ➜ 滾動越快；數字越大 ➜ 滾動越慢

    delay-ms = <0>;

    // 長按時，花多少毫秒加速到最高滾動速度 (預設通常是 300)
    // 數字越小 ➜ 越快達到最高速；設為 0 代表不加速，直接用最高速滾動

    time-to-max-speed-ms = <50>;
};
&mmv {
    // 預設通常是 300，數字越小，游標加速到最高速的時間越短，滑起來會感覺越快、越靈敏
    time-to-max-speed-ms = <100>;

    // 加速曲線指數。預設通常是 1 (線性加速) 或 2 (拋物線加速)。
    // 如果你希望「一按下去就直接用最高速移動」，可以將它設為 0。
    acceleration-exponent = <0>;
    
    // 延遲啟動時間 (與滾輪相同，設為 0 代表隨按隨動)
    delay-ms = <0>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;

    // 點一下、200ms 內再按住同一鍵 ➜ 連發該鍵的 tap 鍵碼（Enter/BSPC/Space...）
    // 而不是進層。想連發就「點、按住」，想進層就直接長按。

    quick-tap-ms = <200>;
};

&num_word {
    // 包含：退格、刪除、加號、減號、等號、小數點、乘號、除號、字母 x (以及對應的 Numpad 代碼)

    continue-list = <BSPC DEL PLUS KP_PLUS MINUS KP_MINUS EQUAL KP_EQUAL DOT KP_DOT STAR KP_MULTIPLY FSLH KP_DIVIDE X>;
};

/*
 * Trackpad: tap still clicks, tap-and-hold no longer drags.
 *
 * The Pinnacle has exactly one knob here — `no-taps` (DIS_TAP) — and it kills
 * tap-to-click and tap-and-hold together, so it is the wrong tool. Instead the
 * dongle intercepts the pad's button events before they reach HID:
 * `zip_button_behaviors` is a stock ZMK input processor that swallows
 * INPUT_BTN_0/1/2 and invokes a behavior instead. Point it at macros, and a
 * macro with no `&macro_pause_for_release` does nothing on release — so a held
 * button becomes a single click and the drag can never start.
 *
 * Consequence, stated plainly: dragging with the pad alone is now impossible.
 * To drag, hold LCLK on layer MOUSE (left hand, D) and move the pad.
 *
 * This node must appear in EVERY processor chain on the listener — a chain
 * that matches a layer replaces the base chain rather than adding to it, so a
 * chain that omits this re-opens dragging on exactly those layers. See
 * boards/shields/toucan/toucan.dtsi.
 */

&zip_button_behaviors { bindings = <&pad_tap_l &pad_tap_r &pad_tap_m>; };

/ {
    behaviors {
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT SEMI>, <&kp COLON>;
        };

        /*
         * PTT 搜推文，NAV 位置 22（原本 z30 / z50 各佔一顆）。
         * 點一下 = z30，連點兩下 = z50。單點要等 200 ms 的 tapping-term
         * 過完才送出——PTT 熱鍵不在乎這半拍。要加第三檔（例如 z100 搜
         * 爆文）就照 z30 再寫一個 macro，bindings 後面補上 <&z100>，
         * 三連點觸發。
         */
        td_ptt: tap_dance_ptt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&z30>, <&z50>;
        };
    };

    /*
     * NAV 的 hjkl：方向鍵 ⇄ 滾輪切換。
     *
     * NAV 位置 34 的 &tog 14 開關 flag 層（HJKL SCRL, 14）。flag 全
     * &trans、自己不做事；只有「NAV(1) 和 flag(14) 同時 active」時，
     * 這裡才把 NAV SCRL(15) 疊上去，蓋掉 hjkl 那四格。所以 flag 開著
     * 回 BASE 打字，hjkl 仍是字母，不會漏滾輪出來。
     */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_hjkl_scroll {
            if-layers = <1 14>;
            then-layer = <15>;
        };
    };

    macros {
        /*
         * The three pad-click macros. `&macro_tap` presses and releases within
         * tap-ms; nothing is queued for the release, which is the whole point —
         * see the &zip_button_behaviors note at the top of this file.
         */

        pad_tap_l: pad_tap_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp LCLK>;
        };

        pad_tap_r: pad_tap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp RCLK>;
        };

        pad_tap_m: pad_tap_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp MCLK>;
        };

        macro0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(A) &kp LS(LG(RIGHT))>;
        };

        claude: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp L &kp A &kp U &kp D &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        z30: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N3 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        z50: macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N5 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        macro4: macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(SPACE) &kp V>;
        };

        /*
         * Claude Code 的斜線指令。跟 cc_usage / cc_model 一樣，打完直接送出。
         * /clear 會清掉整段對話——不想要自動送出的話，把最後那組
         * <&macro_tap>, <&kp ENTER> 兩行刪掉即可（只打字、不按 Enter）。
         */
        cc_clear: cc_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp C &kp L &kp E &kp A &kp R>,
                <&macro_tap>,
                <&kp ENTER>;
        };

        cc_rename: cc_rename {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp R &kp E &kp N &kp A &kp M &kp E>,
                <&macro_tap>,
                <&kp ENTER>;
        };

        wq: macro_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W &kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_continue: macro_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp O &kp N &kp T &kp I &kp N &kp U &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_usage: macro8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp U &kp S &kp A &kp G &kp E>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO8";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_model: macro9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp M &kp O &kp D &kp E &kp L>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO9";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_effort: macro10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp F &kp F &kp O &kp R &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO10";
        };

        cc_exit: macro11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp X &kp I &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO11";
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            // Hand-added, not from the .vil — see regen.sh.
            // Z + / together, after a brief pause. Unlocks ZMK Studio.

            timeout-ms = <200>;
            require-prior-idle-ms = <500>;
            key-positions = <25 34>;
            bindings = <&studio_unlock>;
        };

        combo_0 {
            timeout-ms = <27>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
            layers = <3>;

            // LSFT(KC_9) + LSFT(KC_0) → KC_SPACE
        };

        combo_to_nav {
            timeout-ms = <27>;
            key-positions = <31 32>;
            bindings = <&to 1>;

            // KC_M + KC_COMMA → TO(1)
        };

        combo_tmux {
            timeout-ms = <27>;
            key-positions = <27 28>;
            bindings = <&kp LC(SPACE)>;

            // KC_C + KC_V → LCTL(KC_SPACE)
        };

        combo_wq {
            timeout-ms = <27>;
            key-positions = <2 1>;
            bindings = <&wq>;

            // KC_W + KC_Q → M6
        };

        combo_media {
            timeout-ms = <27>;
            key-positions = <7 8>;
            bindings = <&to 4>;

            // KC_U + KC_I → TO(4)
        };

        combo_num_word {
            timeout-ms = <27>; // 依照你其他 combo 的習慣設定為 27 毫秒
            key-positions = <30 31>; // 對應 BASE 層的 N 和 M
            bindings = <&num_word 2>;
        };

        /*
         * 觸控板速度鎖定。最快 + 中檔 → 鎖最快；最慢 + 中檔 → 鎖最慢。
         * 兩手各一組，中檔本身不可鎖（它是預設的「按住」檔）。
         *
         * layers 一定要含 8 和 10：ZMK 是拿「按下第一顆鍵當下最高的 active
         * layer」去比對這份名單（combo.c 的 zmk_keymap_highest_layer_active），
         * 少了它們，鎖定之後同一組 combo 就解不開。
         *
         * 刻意不含 0（BASE 的 TAB+SPACE / RET+F19 滾鍵永遠不會誤觸）也不含
         * 7（鎖住滾動速度是陷阱：放開 G 之後觸控板會在非滾動狀態持續滾動）。
         *
         * 必須「同時」按下兩顆，先按住一顆再補第二顆不會觸發。50 ms 比其他
         * combo 的 27 ms 寬鬆，因為這幾組已經被 layers 擋在 BASE 之外。
         *
         * HJKL SCRL flag（14）開著時這四組會暫時失效（最高層變 14、不在
         * 名單內）。刻意不把 14 加進名單，原因見 layer_14 的註解。
         */
        combo_lock_fast_l {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = <&tog 10>;
            layers = <6 8 10>;
        };

        combo_lock_fast_r {
            timeout-ms = <50>;
            key-positions = <40 41>;
            bindings = <&tog 10>;
            layers = <6 8 10>;
        };

        combo_lock_slowest_l {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&tog 8>;
            layers = <6 8 10>;
        };

        combo_lock_slowest_r {
            timeout-ms = <50>;
            key-positions = <39 40>;
            bindings = <&tog 8>;
            layers = <6 8 10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &mt LALT A  &mt LCTRL S  &mt LGUI D  &mt LSHFT F  &lt 7 G  &lt 7 H  &mt LSHFT J  &mt LGUI K  &mt LCTRL L  &td5  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp F18  &kp FSLH  &none  &lt 3 TAB  &lt 4 SPACE  &lt 1 ESC  &lt 2 BSPC  &lt 5 RET  &lt 3 F19
            >;
        };

        layer_1 {
            display-name = "NAV";

            /*
             * Positions 3 and 4 are hand-added (see regen.sh):
             *   &studio_unlock — a second way in if the Z + / combo ever
             *                    stops working. Left thumb ESC + E, and
             *                    the thumb must be held past 200 ms.
             *   &bootloader    — left thumb ESC + R. Saves prying the
             *                    dongle out to double-tap RST on a reflash.
             *
             * Positions 22 and 34 are also hand-changed:
             *   22 &td_ptt — z30 / z50 合併：點一下 z30、連點兩下 z50。
             *   34 &tog 14 — hjkl 方向鍵 ⇄ 滾輪切換，見 conditional_layers
             *                和 layer_14 / layer_15 的註解。
             */

            bindings = <
&none  &cc_exit  &cc_clear  &none  &cc_rename  &macro4  &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &to 0  &none  &none  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &kp LS(LA(LC(LG(T))))  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &td_ptt  &none  &none  &cc_effort  &cc_model  &cc_continue  &cc_usage  &claude  &kp END  &kp PG_DN  &kp PG_UP  &kp HOME  &tog 14  &none  &none  &none  &kp ESC  &kp BSPC  &kp DEL  &kp F19
            >;
        };

        layer_2 {
            display-name = "NUM";
            bindings = <
&none  &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS  &none  &none  &none  &none  &none  &none  &none  &kp KP_DIVIDE  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS  &none  &kp LSHFT  &kp LGUI  &kp LCTRL  &kp LALT  &none  &none  &kp X  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_EQUAL  &none  &none  &none  &none  &none  &none  &kp KP_N0  &kp KP_DOT  &kp PRCNT  &kp BACKSPACE  &kp ENTER  &kp F19
            >;
        };

        layer_3 {
            display-name = "SYMBOL";
            bindings = <
&none  &kp QMARK  &kp EXCL  &kp LBKT  &kp RBKT  &kp KP_PLUS  &kp AT  &kp HASH  &kp DLLR  &kp DQT  &kp GRAVE  &none  &none  &kp LT  &kp GT  &kp LPAR  &kp RPAR  &kp MINUS  &kp TILDE  &mt LSHFT SQT  &kp LGUI  &kp LCTRL  &mt LALT COLON  &none  &none  &kp PIPE  &kp AMPS  &kp LBRC  &kp RBRC  &kp KP_EQUAL  &kp CARET  &kp STAR  &kp COMMA  &kp BSLH  &kp FSLH  &none  &kp UNDER  &kp DOT  &kp PRCNT  &kp LS(LC(LA(LG(E))))  &kp LA(SPACE)  &kp LC(LG(A))
            >;
        };

        layer_4 {
            display-name = "MEDIA";
            bindings = <
&none  &kp LG(Q)  &kp LG(W)  &kp LG(E)  &kp LS(LG(Z))  &kp LG(T)  &kp LC(U)  &kp LC(W)  &kp LA(DEL)  &kp LC(K)  &to 0  &none  &none  &mt LALT LG(A)  &mt LCTRL LG(S)  &mt LGUI LG(D)  &mt LSHFT LG(F)  &kp LG(L)  &trans  &kp LG(LEFT)  &kp LG(RIGHT)  &kp LS(LA(LC(LG(E))))  &kp LG(LS(T))  &none  &none  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &kp LC(A)  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LA(LS(RIGHT))  &kp LG(W)  &none  &kp LS(LC(LA(LG(GRAVE))))  &sl 5  &none  &mo 1  &mo 16  &kp F19
            >;
        };

        layer_5 {
            display-name = "FUN";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp C_VOL_UP  &kp LS(LC(LA(LG(L))))  &kp LS(LC(LA(LG(E))))  &kp LS(LC(LA(LG(F))))  &kp LS(LC(LA(LG(T))))  &kp LS(LG(N5))  &none  &none  &kp F11  &kp F4  &kp F5  &kp F6  &kp C_MUTE  &kp LS(LC(LA(LG(Y))))  &kp LSHFT  &kp LGUI  &kp LCTRL  &kp LALT  &none  &none  &kp F10  &kp F1  &kp F2  &kp F3  &kp C_VOL_DN  &kp LS(LC(LA(LG(M))))  &kp LS(LC(LA(LG(A))))  &kp LS(LC(LA(LG(N))))  &kp LS(LC(LA(LG(G))))  &kp LS(LC(LA(LG(O))))  &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp LS(LC(LA(LG(P))))  &none  &kp LS(LC(LA(LG(V))))
            >;
        };

        /*
         * MOUSE — 觸控板一動就由 toucan.dtsi 的 &mouse_temp_layer 6 150
         * 自動升起，停手 150 ms 後掉下來。bindings 與 SCROLL (7) 共用
         * PAD_BINDINGS，只有六顆拇指不同：這裡指向游標三檔。
         *
         * 拇指規則：越內側越快、越外側越慢，兩手對稱，全部是「按住」。
         *   36/41 (最內) = 最快 3.75x     37/40 (中)  = 中檔 1.25x
         *   38/39 (最外，layer 0 的 ESC / BSPC 位) = 最慢 0.62x
         * 鎖定走 combo（見上面的 combo_lock_*），拇指上沒有 toggle。
         */
        layer_6 {
            display-name = "MOUSE";
            bindings = <PAD_BINDINGS(&mo 10, &mo 9, &mo 8, &mo 8, &mo 9, &mo 10)>;
        };

        /*
         * SCROLL — BASE 按住 G / H (&lt 7) 進入，觸控板變滾輪。
         * scroller_default 在 toucan.dtsi 用 layers = <1 2 7> 認這一層。
         * 拇指位置與 MOUSE 相同，但指向滾動三檔；滾動刻意不提供鎖定。
         */
        layer_7 {
            display-name = "SCROLL";
            bindings = <PAD_BINDINGS(&mo 13, &mo 12, &mo 11, &mo 11, &mo 12, &mo 13)>;
        };

        /*
         * 以下六層都是 marker layer：本身不綁任何功能，存在的意義就是讓
         * toucan.dtsi 的 input-listener 知道要換哪一條處理鏈。全部 &trans，
         * 這樣按住的時候底下那層的按鍵照常可用。
         *
         * 可鎖定的兩層 (8 最慢 / 10 最快) 在位置 10 (P) 放 &to 0：鎖定之後
         * 觸控板停下、layer 6 掉了，這是唯一能把鎖定清掉的逃生口。
         */
        layer_8 {
            display-name = "CUR SLOWEST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9 {
            display-name = "CUR SLOW";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_10 {
            display-name = "CUR FAST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_11 {
            display-name = "SCRL SLOWEST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_12 {
            display-name = "SCRL SLOW";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_13 {
            display-name = "SCRL FAST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /*
         * HJKL SCRL — hand-added 的 flag 層。全 &trans，只當開關狀態用：
         * NAV 位置 34 的 &tog 14 切換。開著時 dongle 螢幕顯示的最高層就是
         * 這個名字，等於免費的狀態指示燈。實際蓋鍵的是下面的 NAV SCRL(15)，
         * 由 conditional_layers 在 NAV+flag 同時 active 時自動疊上。
         *
         * 兩個已知取捨：
         *   1. 這層 index (14) 高於 MOUSE(6)/CUR*(8/10)，flag 開著時
         *      combo_lock_*（觸控板調速鎖定）比對到的最高層是 14、不在
         *      名單內 ⇒ 那四組 combo 暫時失效。刻意「不」把 14 加進名單：
         *      加了它們就會在 BASE 打字時活過來，拇指快速連按會誤觸
         *      &tog 8/10。要鎖速度就先把 flag 關掉。
         *   2. 任何 &to（NAV 的 P、PAD 層位置 10、combo_to_nav）都會把
         *      flag 一併清掉——&to 只保留目標層和 default 層。
         */
        layer_14 {
            display-name = "HJKL SCRL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /*
         * NAV SCRL — 由 conditional_layers 自動疊上，不要手動 &tog/&mo 它。
         * 只蓋 NAV 的 hjkl 四格（18-21），方向與 SCROLL 層（PAD_BINDINGS）
         * 右手 home row 完全相同；其餘 &trans 落回 NAV——位置 34 也因此
         * 落回 &tog 14，再按一次就切回方向鍵。
         */
        layer_15 {
            display-name = "NAV SCRL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc MOVE_X(KB_SCRL)  &msc MOVE_Y(KB_SCRL)  &msc MOVE_Y(-KB_SCRL)  &msc MOVE_X(-KB_SCRL)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /*
         * BT — 主機配對與輸出切換。2026-09-01 左半改當 split central 之後
         * 才需要：以前所有主機配對都在 dongle 上，鍵盤本身一顆 &bt 都沒有。
         *
         * 進入方式：MEDIA(4) 位置 40 的 &mo 16。MEDIA 自己由 BASE 按住
         * SPACE（&lt 4 SPACE，左拇指）或 combo_media 的 &to 4 進入，所以
         * 兩種握法都按得到——左拇指 + 右拇指 + 左手指。
         *
         * 刻意做成「按住」而不是 &tog：這層有 &bt BT_CLR 和 &bootloader，
         * latch 住再誤觸的代價太高。
         *
         *   Q W E R T  = BT profile 0-4        A S D = 輸出 USB / BLE / 切換
         *   Z          = BT_CLR（清掉目前 profile 的配對）
         *   B          = &bootloader           P     = &to 0 逃生口
         *
         * &bootloader 重置的是「按下它的那一側」，也就是左半——而左半現在
         * 正是最常刷的那顆板子，所以這顆鍵第一次真正有用了。（FLASHING.md
         * 那次事故正是因為當年它重置的是左半、使用者以為是 dongle。）
         *
         * 右手整排 &trans 是刻意的：這層只用左手，右手保持 MEDIA 的行為。
         */
        layer_16 {
            display-name = "BT";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &to 0  &none  &none  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &bt BT_CLR  &trans  &trans  &trans  &bootloader  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
