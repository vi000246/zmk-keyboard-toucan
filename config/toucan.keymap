/*
 * beekeeb Toucan (dongle mode) keymap
 *
 * GENERATED by keyboard-manager from beekeeb 36key.vil — do not hand-edit if you
 * intend to regenerate. Change the layout in Vial, re-export, and diff.
 *
 * Read CONVERSION-REPORT.md first: it lists everything that did not map
 * cleanly from QMK to ZMK.
 */

#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Hold-tap feel, carried over from the .vil's QMK settings.
 *   tapping-term-ms — Vial "Tapping Term"
 *   flavor          — derived from Vial's permissive-hold / mod-tap-interrupt
 *                     flags. If home-row mods misfire, this is the knob:
 *                     "tap-preferred" is the most forgiving, "hold-preferred"
 *                     the most eager. See zmk.dev/docs/keymaps/behaviors/hold-tap
 */

&msc {
    // 每次滾動訊號送出的間隔時間 (預設通常是 10 或 15)
    // 數字越小 ➜ 滾動越快；數字越大 ➜ 滾動越慢

    delay-ms = <0>;

    // 長按時，花多少毫秒加速到最高滾動速度 (預設通常是 300)
    // 數字越小 ➜ 越快達到最高速；設為 0 代表不加速，直接用最高速滾動

    time-to-max-speed-ms = <50>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;

    // 點一下、200ms 內再按住同一鍵 ➜ 連發該鍵的 tap 鍵碼（Enter/BSPC/Space...）
    // 而不是進層。想連發就「點、按住」，想進層就直接長按。

    quick-tap-ms = <200>;
};

&num_word {
    // 包含：退格、刪除、加號、減號、等號、小數點、乘號、除號、字母 x (以及對應的 Numpad 代碼)

    continue-list = <BSPC DEL PLUS KP_PLUS MINUS KP_MINUS EQUAL KP_EQUAL DOT KP_DOT STAR KP_MULTIPLY FSLH KP_DIVIDE X>;
};

/*
 * Trackpad: tap still clicks, tap-and-hold no longer drags.
 *
 * The Pinnacle has exactly one knob here — `no-taps` (DIS_TAP) — and it kills
 * tap-to-click and tap-and-hold together, so it is the wrong tool. Instead the
 * dongle intercepts the pad's button events before they reach HID:
 * `zip_button_behaviors` is a stock ZMK input processor that swallows
 * INPUT_BTN_0/1/2 and invokes a behavior instead. Point it at macros, and a
 * macro with no `&macro_pause_for_release` does nothing on release — so a held
 * button becomes a single click and the drag can never start.
 *
 * Consequence, stated plainly: dragging with the pad alone is now impossible.
 * To drag, hold LCLK on layer MOUSE (left hand, D) and move the pad.
 *
 * This node must appear in EVERY processor chain on the listener — a chain
 * that matches a layer replaces the base chain rather than adding to it, so a
 * chain that omits this re-opens dragging on exactly those layers. See
 * boards/shields/toucan/toucan.dtsi.
 */

&zip_button_behaviors { bindings = <&pad_tap_l &pad_tap_r &pad_tap_m>; };

/ {
    behaviors {
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT SEMI>, <&kp COLON>;
        };
    };

    macros {
        /*
         * The three pad-click macros. `&macro_tap` presses and releases within
         * tap-ms; nothing is queued for the release, which is the whole point —
         * see the &zip_button_behaviors note at the top of this file.
         */

        pad_tap_l: pad_tap_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp LCLK>;
        };

        pad_tap_r: pad_tap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp RCLK>;
        };

        pad_tap_m: pad_tap_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp MCLK>;
        };

        macro0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(A) &kp LS(LG(RIGHT))>;
        };

        claude: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp L &kp A &kp U &kp D &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        z30: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N3 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        z50: macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N5 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        macro4: macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(SPACE) &kp V>;
        };

        macro5: macro_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(SPACE) &kp V &kp COMMA &kp S>;
        };

        wq: macro_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W &kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_continue: macro_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp O &kp N &kp T &kp I &kp N &kp U &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_usage: macro8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp U &kp S &kp A &kp G &kp E>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO8";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_model: macro9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp M &kp O &kp D &kp E &kp L>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO9";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_effort: macro10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp F &kp F &kp O &kp R &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO10";
        };

        cc_exit: macro11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp X &kp I &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO11";
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            // Hand-added, not from the .vil — see regen.sh.
            // Z + / together, after a brief pause. Unlocks ZMK Studio.

            timeout-ms = <200>;
            require-prior-idle-ms = <500>;
            key-positions = <25 34>;
            bindings = <&studio_unlock>;
        };

        combo_0 {
            timeout-ms = <27>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
            layers = <3>;

            // LSFT(KC_9) + LSFT(KC_0) → KC_SPACE
        };

        combo_to_nav {
            timeout-ms = <27>;
            key-positions = <31 32>;
            bindings = <&to 1>;

            // KC_M + KC_COMMA → TO(1)
        };

        combo_tmux {
            timeout-ms = <27>;
            key-positions = <27 28>;
            bindings = <&kp LC(SPACE)>;

            // KC_C + KC_V → LCTL(KC_SPACE)
        };

        combo_wq {
            timeout-ms = <27>;
            key-positions = <2 1>;
            bindings = <&wq>;

            // KC_W + KC_Q → M6
        };

        combo_media {
            timeout-ms = <27>;
            key-positions = <7 8>;
            bindings = <&to 4>;

            // KC_U + KC_I → TO(4)
        };

        combo_num_word {
            timeout-ms = <27>; // 依照你其他 combo 的習慣設定為 27 毫秒
            key-positions = <30 31>; // 對應 BASE 層的 N 和 M
            bindings = <&num_word 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &mt LALT A  &mt LCTRL S  &mt LGUI D  &mt LSHFT F  &lt 8 G  &lt 8 H  &mt LSHFT J  &mt LGUI K  &mt LCTRL L  &td5  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp F18  &kp FSLH  &none  &lt 3 TAB  &lt 4 SPACE  &lt 1 ESC  &lt 2 BSPC  &lt 5 RET  &lt 3 F19
            >;
        };

        layer_1 {
            display-name = "NAV";

            /*
             * Positions 3 and 4 are hand-added (see regen.sh):
             *   &studio_unlock — a second way in if the Z + / combo ever
             *                    stops working. Left thumb ESC + E, and
             *                    the thumb must be held past 200 ms.
             *   &bootloader    — left thumb ESC + R. Saves prying the
             *                    dongle out to double-tap RST on a reflash.
             */

            bindings = <
&none  &cc_exit  &none  &none  &macro5  &macro4  &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &to 0  &none  &none  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &kp LS(LA(LC(LG(T))))  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &z30  &none  &none  &cc_effort  &cc_model  &cc_continue  &cc_usage  &claude  &kp END  &kp PG_DN  &kp PG_UP  &kp HOME  &z50  &none  &none  &none  &kp ESC  &kp BSPC  &kp DEL  &kp F19
            >;
        };

        layer_2 {
            display-name = "NUM";
            bindings = <
&none  &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS  &none  &none  &none  &none  &none  &none  &none  &kp KP_DIVIDE  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS  &none  &kp LSHFT  &kp LGUI  &kp LCTRL  &kp LALT  &none  &none  &kp X  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_EQUAL  &none  &none  &none  &none  &none  &none  &kp KP_N0  &kp KP_DOT  &kp PRCNT  &kp BACKSPACE  &kp ENTER  &kp F19
            >;
        };

        layer_3 {
            display-name = "SYMBOL";
            bindings = <
&none  &kp QMARK  &kp EXCL  &kp LBKT  &kp RBKT  &kp KP_PLUS  &kp AT  &kp HASH  &kp DLLR  &kp DQT  &kp GRAVE  &none  &none  &kp LT  &kp GT  &kp LPAR  &kp RPAR  &kp MINUS  &kp TILDE  &mt LSHFT SQT  &kp LGUI  &kp LCTRL  &mt LALT COLON  &none  &none  &kp PIPE  &kp AMPS  &kp LBRC  &kp RBRC  &kp KP_EQUAL  &kp CARET  &kp STAR  &kp COMMA  &kp BSLH  &kp FSLH  &none  &kp UNDER  &kp DOT  &kp PRCNT  &kp LS(LC(LA(LG(E))))  &kp LA(SPACE)  &kp LC(LG(A))
            >;
        };

        layer_4 {
            display-name = "MEDIA";
            bindings = <
&none  &kp LG(Q)  &kp LG(W)  &kp LG(E)  &kp LS(LG(Z))  &kp LG(T)  &kp LC(U)  &kp LC(W)  &kp LA(DEL)  &kp LC(K)  &to 0  &none  &none  &mt LALT LG(A)  &mt LCTRL LG(S)  &mt LGUI LG(D)  &mt LSHFT LG(F)  &kp LG(L)  &mo 8  &kp LG(LEFT)  &kp LG(RIGHT)  &kp LS(LA(LC(LG(E))))  &kp LG(LS(T))  &none  &none  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &kp LC(A)  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LA(LS(RIGHT))  &kp LG(W)  &none  &kp LS(LC(LA(LG(GRAVE))))  &sl 5  &none  &mo 1  &none  &kp F19
            >;
        };

        layer_5 {
            display-name = "FUN";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp C_VOL_UP  &kp LS(LC(LA(LG(L))))  &kp LS(LC(LA(LG(E))))  &kp LS(LC(LA(LG(F))))  &kp LS(LC(LA(LG(T))))  &kp LS(LG(N5))  &none  &none  &kp F11  &kp F4  &kp F5  &kp F6  &kp C_MUTE  &kp LS(LC(LA(LG(Y))))  &kp LSHFT  &kp LGUI  &kp LCTRL  &kp LALT  &none  &none  &kp F10  &kp F1  &kp F2  &kp F3  &kp C_VOL_DN  &kp LS(LC(LA(LG(M))))  &kp LS(LC(LA(LG(A))))  &kp LS(LC(LA(LG(N))))  &kp LS(LC(LA(LG(G))))  &kp LS(LC(LA(LG(O))))  &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp LS(LC(LA(LG(P))))  &none  &kp LS(LC(LA(LG(V))))
            >;
        };

        /*
         * MOUSE — hand-added, see regen.sh. Switched on automatically while
         * the trackpad is moving, by `&mouse_temp_layer 6 150` in
         * boards/shields/toucan/toucan.dtsi. It drops again 150 ms after the
         * last movement, or as soon as you press a key that is not in that
         * node's `excluded-positions`.
         *
         * A resting finger produces no movement events, so after 150 ms the
         * layer falls out from under the hand. The escape hatch is H
         * (position 18): it holds layer SCROLL (`&mo 8`), a verbatim copy of
         * this layer, for exactly as long as the finger holds it — no
         * timers. While H is down the pad also SCROLLS (one finger, up/down)
         * instead of moving the cursor, because the listener's `scroller`
         * node matches layer 8. See layer_8 below for why it is a copy
         * rather than a re-hold of this layer.
         *
         * Most keys are on the LEFT hand on purpose: the trackpad lives on
         * the right half, so the hand that is not on the pad does the
         * clicking. The right hand keeps a few controls anyway:
         * Y/U = prev/next tab, H = hold SCROLL, P = back to BASE,
         * right thumb-left = Cmd+W.
         *
         * Those excluded positions are every key bound below or on SCROLL —
         * left-hand q w e r t / a s d f g / z x c v b rows, right-hand
         * Y U H P (6 7 18 10), all three left thumbs (36-38) and the right
         * thumb-left (39). Move a binding here and you must move the
         * position there, or pressing it switches the layer off under you.
         *
         * Left thumbs, while the pad is in use:
         *   left   (36) — Cmd+[  = browser back
         *   middle (37) — Cmd+]  = browser forward
         *                 (Cmd+[/] instead of &mkp MB4/MB5 because Firefox on
         *                 macOS ignores mouse buttons 4/5)
         *   right  (38) — ESC
         * A holds LGUI so cmd-click is one hand each; S holds layer SLOW,
         * which the listener watches for — nothing on that layer does
         * anything, the layer *being on* is the signal (half cursor speed).
         * All of these replace their base-layer bindings only while MOUSE
         * (or SCROLL) is up.
         */

        layer_6 {
            display-name = "MOUSE";
            bindings = <
&trans  &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &msc MOVE_Y(50)  &msc MOVE_Y(-50)  &kp HOME  &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &to 0  &trans  &trans  &kp LEFT_COMMAND  &mo 8  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &msc MOVE_Y(20)  &msc MOVE_Y(-20)  &trans  &trans  &trans  &trans  &to 0  &trans  &kp PG_DN  &kp PG_UP  &kp END  &kp LG(W)  &kp LG(LS(T))  &trans  &trans  &trans  &trans  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &lt 1 ESCAPE  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        /*
         * SLOW — a marker layer, held from MOUSE's right thumb. It binds
         * nothing: `slow_cursor` in boards/shields/toucan/toucan.dtsi keys off
         * `layers = <7>` and swaps the pointer scaler from 250/100 to 125/100,
         * i.e. exactly half. Keep every position &trans so the keys underneath
         * keep working while it is held.
         */

        layer_7 {
            display-name = "SLOW";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /*
         * SCROLL — held via `&mo 8` on MOUSE's H (position 18). This is a
         * verbatim COPY of layer_6 (keep them in sync!), except position 18
         * itself is &trans because that key is busy holding the layer.
         *
         * Why a copy instead of holding layer 6 directly: ZMK layer state is
         * a shared bitmask with no reference counting, so the temp-layer
         * processor's 1 s timeout and a manual hold of the SAME layer can
         * fight each other. A separate layer has a single owner (the H hold)
         * and cannot be dropped by any timer. The `scroller` node in
         * boards/shields/toucan/toucan.dtsi watches this layer
         * (`layers = <1 2 8>`), so while H is held the pad scrolls.
         */

        layer_8 {
            display-name = "SCROLL";
            bindings = <
&trans  &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &msc MOVE_Y(50)  &msc MOVE_Y(-50)  &kp HOME  &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &to 0  &trans  &trans  &kp LEFT_COMMAND  &mo 8  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &msc MOVE_Y(20)  &msc MOVE_Y(-20)  &trans  &trans  &trans  &trans  &to 0  &trans  &kp PG_DN  &kp PG_UP  &kp END  &kp LG(W)  &kp LG(LS(T))  &trans  &trans  &trans  &trans  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &lt 1 ESCAPE  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        extra_3 { status = "reserved"; };
    };
};
