/*
 * beekeeb Toucan (dongle mode) keymap
 *
 * GENERATED by keyboard-manager from beekeeb 36key.vil — do not hand-edit if you
 * intend to regenerate. Change the layout in Vial, re-export, and diff.
 *
 * Read CONVERSION-REPORT.md first: it lists everything that did not map
 * cleanly from QMK to ZMK.
 */
/*
 * ── 本分支（prospector-scanner-windows）＝ Windows 版 ───────────────────
 *
 * 2026-09-07 從 prospector-scanner 分出來。原則：**操作語意一致，鍵碼各自
 * 原生**——不是傻傻地把 Cmd 換成 Ctrl，每一顆都對到 Windows 真正的做法。
 * 對照的權威來源是 piantor/README.md（Piantor Pro 就是這套 layout 的
 * Windows 版，2026-09-04 已實機驗證），本檔完全沿用那份定案：
 *
 *   分頁切換        ⇧⌘[ / ⇧⌘]      → Ctrl+PgUp / Ctrl+PgDn
 *   瀏覽歷史        ⌘[ / ⌘]        → Alt+← / Alt+→
 *   關程式          ⌘Q             → Alt+F4
 *   重做            ⇧⌘Z            → Ctrl+Y
 *   關/開分頁       ⌘W / ⌘T        → Ctrl+W / Ctrl+T
 *   剪貼/復原等     ⌘Z X C V B...  → Ctrl+同字母
 *   行首/行尾       ⌘← / ⌘→        → Home / End
 *   跳字            ⌥← / ⌥→        → Ctrl+← / Ctrl+→（選取加 Shift 同理）
 *   四顆刪除鍵(YUIO) ⌘⌫ ⌥⌫ ⌥⌦ ⌃K   → Ctrl+U / Ctrl+⌫ / Ctrl+Del / Ctrl+K
 *   截圖            ⇧⌘5            → Win+Shift+S
 *   切輸入法        F18            → Win+Space
 *   縮放            ⌘+ / ⌘0        → Ctrl+= / Ctrl+0
 *   重新整理        ⌘R             → Ctrl+R
 *   同程式切視窗    ⌘`             → Alt+Esc（Windows 沒有原生同程式循環，
 *                                     Alt+Esc 是最接近的免選單循環切換）
 *   app 焦點熱鍵    Hyper+L/E/F/T  → Ctrl+Win+1~4（工作列釘選 1~4 號）
 *   NUM 層數字      KP_N0~9/KP_DOT → 數字列 N0~9 / DOT（NumLock 關閉時
 *                                     KP_7 在 Windows 會變 Home，全部避開）
 *
 * 不變的：Hyper 巨集（⌃⌥⇧⌘+字母，HID 兩邊相同，主機端 AHK 接手）、
 * Alt+P / Alt+Space / Ctrl+Space(tmux) / Ctrl+K / F19、所有打字巨集、
 * home row 裸修飾鍵（fb3fc56 起兩把鍵盤就是「位置一致」：S=GUI、D=Ctrl）。
 *
 * ⚠️ 下方歷史註解裡提到的 mac 鍵碼（LG(W) 之類）維持原文不改，讀的時候
 *    對照本表換算即可。
 */
/*
 * ── 層名：全部 ≤ 4 字元，這是硬約束 ─────────────────────────────────────
 *
 * 2026-09-03 改名。三個獨立的理由指向同一個上限：
 *
 *   1. Prospector 廣播欄位 `layer_name[4]` 就是 4 bytes（見
 *      status_advertisement.h）。超過直接截斷，而截斷會「撞名」——舊的
 *      CUR SLOWEST / CUR SLOW / CUR FAST 三層全部塌成 "CUR "，
 *      三個 SCRL 檔全部塌成 "SCRL"，NAV SCRL 撞 NAV。
 *   2. dongle 的儀表板版面把層名排成固定 50px 單行、不 wrap 不縮字。
 *      只要每個名字都 ≤4 字，溢出就不是「大概不會」而是不可能。
 *   3. 鍵盤自己的 nice_view 用 quinquefive_24（每字約 29px）、畫布寬
 *      144px ⇒ 一行也就 4–5 字。
 *
 *   #  名稱   說明
 *   ─────────────────────────────────────────────────────────────────
 *   0  BASE   打字
 *   1  NAV    方向鍵 / 視窗 / Claude Code 巨集
 *   2  NUM    數字鍵盤
 *   3  SYM    符號（小抄靠這名字查表，見下方 layer_3）
 *   4  CMD    Cmd 快捷 / 視窗 / 剪貼
 *   5  FUN    F1-F12 / 音量 / Hyper 巨集
 *   6  PAD    觸控板自動升起的點擊層
 *   7  SCRL   按住 G/H：觸控板變滾輪
 *   8  CUR-   游標 1.25x（PAD 拇指 38/39）
 *   9  CUR+   游標 3.75x（PAD 拇指 37/40）
 *  10  SCR-   滾動 50%（SCRL 拇指 38/39）
 *  11  SCR+   滾動 200%（SCRL 拇指 37/40）
 *  12  BT     配對 / 輸出切換 / bootloader
 *
 * ── 2026-09-09：NAV / NUM 的 index 修回 1 / 2 ─────────────────────────
 *
 * 層 index 是照 **devicetree 節點出現的順序**算的，跟節點名字 `layer_N`
 * 無關。2026-09-06 的 fb3fc56（keymap-editor bot）把 NUM 的節點搬到 NAV
 * 前面，於是檔案變成「節點叫 layer_1、display-name 是 NAV，但實際 index
 * 是 2」——名字和 index 互相矛盾，讀檔的人（和 bot）每次都要重新推一遍。
 *
 * 這一版把 NAV 的節點搬回第一個，讓 **節點名 = display-name 的層 = 真正的
 * index** 三者一致，也回到 Piantor 一直在用的編號（`LT1(KC_ESCAPE)` = NAV、
 * `LT2(KC_BSPACE)` = NUM）與 regen.sh 的 LAYER_NAMES 順序。
 * 行為完全不變：ESC 拇指仍升 NAV、BSPC 拇指仍升 NUM，只是 &lt 的數字跟著換。
 *
 * ⇒ 以後檢查很簡單：**節點順序就是 index，兩者對不上就是有人動過順序**。
 *   跟著要核對的是 &num_word 的層參數（見下方 combo_num_word）和
 *   radii_layout.c 的 LAYERS[]，那兩處 bot 不會幫你重編號。
 *
 * ── 2026-09-04 這一版砍掉四層（17 → 13）──────────────────────────────
 *
 *   CUR (舊 9) / SCR (舊 12)  三檔調速收成兩檔，中間那顆拇指空出來。
 *                             留下的慢檔直接繼承舊中檔的速度（1.25x / 50%），
 *                             因為舊的最慢檔（0.62x / 25%）實測太鈍。
 *   HJKL (舊 14) / WHEL (舊 15)  hjkl 方向鍵⇄滾輪的 flag 層。常常誤觸而且
 *                             會 latch 住，使用者要求移除；conditional_layers
 *                             節點也跟著整個刪掉。
 *
 * 連帶刪掉的還有四組 combo_lock_*（觸控板速度鎖定）——三檔變兩檔之後，
 * 僅存的兩顆調速鍵 37/38 相鄰，拇指滾動時會誤觸 `37+38` 那組而鎖住速度。
 * 以後真的需要鎖定再重做，屆時建議用空出來的 36/41 當「鎖定修飾鍵」
 * （36+37 鎖快、36+38 鎖慢），兩顆調速鍵之間怎麼滾都不會誤觸。
 *
 * ⚠️ 改名 / 改層數時要一起動的地方：
 *   - regen.sh 的 LAYER_NAMES（層 0-5）與 Patch 3 的硬編碼 MOUSE_LAYER
 *     字串——不改的話下次 regen 會把舊名寫回來。
 *   - SYM 若改名，還要同步 nice_view_gem/widgets/cheatsheet.c 和
 *     scanner-module/.../radii_layout.c 的 CHEAT_LAYER_NAME（兩者都只
 *     認 "SYM"）。所以 SYM 刻意不改。
 *   - boards/shields/toucan/toucan-trackpad.dtsi 各處理鏈的 `layers = <>`
 *     是寫死的 index，加/刪/重排層一定要同步。
 *   - dongle 儀表板的副標表（radii_layout.c 的 LAYERS[] 與 LAYER_COUNT）
 *     是用 layer index 查的，只有「加/刪/重排層」才要動，改名不用。
 *
 * ⚠️ 刷進去後 dongle 若仍顯示舊名 → 先做 ZMK Studio 的
 *    Restore Stock Settings（flash 裡的 Studio 設定會蓋掉 keymap）。
 */

#include <behaviors/num_word.dtsi>

/* 左半改當 split central 之後才需要的：主機配對與輸出切換都歸鍵盤自己管。 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * 鍵盤滑鼠鍵的速度（&mmv 游標 / &msc 滾輪）。這裡只管「用鍵盤推游標 / 滾輪」，
 * 觸控板本身的速度在 boards/shields/toucan/toucan-trackpad.dtsi 的 PAD_* 那組。
 *
 * ⚠️ 2026-09-02 起不再用 #define / 函式巨集，速度全部寫成字面數字——
 * nickcoutsos keymap-editor 的 parser 不吃 bindings 裡的自訂前處理器巨集，
 * 看到就整份拒收（MOVE_X/MOVE_Y/LS() 這類 ZMK 官方巨集沒問題）。
 * 代價是「改速度要同步改多處」，對照表：
 *
 * 單位（ZMK behavior-input-two-axis：speed 的單位是「每秒」，trigger-period-ms
 * 預設 16 只決定更新顆粒，不影響速度）：
 *   &mmv MOVE_x(N) = N 像素 / 秒
 *   &msc MOVE_x(N) = N 格滾輪 / 秒
 *
 *   游標基準 500（ZMK 預設 600；下面 &mmv 設 accel-exponent=0 ⇒ 全程等速）
 *     出現處：SCRL(7) 的 ±500 四格
 *   滾輪基準 25（ZMK 預設 10）
 *     出現處：SCRL(7) 的 ±25 八格
 *   調速兩檔：
 *     SCR-(10)：游標 ±250   滾輪 ±10   （游標 50%、滾輪 40%）
 *     SCR+(11)：游標 ±1000  滾輪 ±40   （游標 200%、滾輪 160%）
 *
 * ── 2026-09-09 游標三檔整體砍到 1/3 ──────────────────────────────────
 *
 * 舊值 750 / 1500 / 2250 實測太衝——&mmv 是全程等速（見下面 exponent=0），
 * 1500 px/s 等於一按就飛過目標。新值把基準訂在 **500**，兩側維持
 * 50% / 100% / 200% 的兩倍關係（跟滾輪同一種刻度，好記）：
 *
 *     SCR-(10)   750 → 250
 *     SCRL(7)   1500 → 500     ← 基準
 *     SCR+(11)  2250 → 1000
 *
 * 中途曾試 250/500(基準 750)/1500，750 仍偏快而作廢；1000 這一檔是刻意
 * **沒有**回到舊基準 1500 的——真要那麼快就直接用觸控板，游標鍵的用途是
 * 「最後幾像素的微調」。要更大的頂檔就把 SCR+ 的四格改成 1500。
 *
 * ⚠️ 游標三檔的調整**只動 &mmv（鍵盤游標鍵）**。觸控板刻意沒碰——它走
 *    input processor，速度在 toucan-trackpad.dtsi 的 PAD_* 那組，而那組是
 *    **平台個人化、不跨分支 sync** 的（見 CLAUDE.md）。
 *
 * 同一天順手修掉一個左右不對稱：SCR+(11) 的滾輪左手四格是 40、右手四格
 * （位置 18-21）卻是 45，右手因此快 12.5%。已統一成 40。
 * ⇒ 現在三個滾輪檔各自左右同值：SCR- 10 / SCRL 25 / SCR+ 40，
 *   要驗證很容易——同一層的 &msc 只該出現一種絕對值。
 */
/*
 * SCRL (7) 的 42 格 bindings。
 *
 * ── 為什麼 6 和 7 不再共用同一份 ───────────────────────────────────────
 *
 * 這兩層的「進入方式」根本不同，所以能承受的內容也不同：
 *
 *   layer 6 (PAD)  觸控板一動就「自動」升起。你沒有要求它。
 *   layer 7 (SCRL) BASE 按住 G / H 才進來。是你刻意要的。
 *
 * 自動升起的層必須近乎無害——因為用完觸控板接著打字時，timeout 窗口內每一顆
 * 鍵都會落在它上面。原本兩層共用這份 bindings，等於 layer 6 有 28 格是活的、
 * 整排 home row 都是 &msc / &mmv，而位置 1 是 &kp LG(W)（關分頁）、位置 25 是
 * &kp LS(LG(T))（重開分頁）。打 the 的 e 是游標上移，打 and 三個字母全中。
 * 那不是 timeout 設太長，是這一層裝了不該裝的東西。
 *
 * 所以 layer 6 瘦身成「只有點擊 + 調速 + 逃生口」，其餘全 &trans（見下面的
 * layer_6）。進階操作全部留在這一層，反正你是刻意按住 G / H 進來的。
 *
 * 被移出 layer 6 的東西在別層都有，不會消失：
 *   位置 6-9   分頁切換 / 上下頁  → NAV 層同位置就有
 *   位置 30-33 End/PgDn/PgUp/Home → NAV 層同位置就有
 *   位置 1     &kp LG(W)          → CMD 層位置 2
 *   位置 25    &kp LS(LG(T))      → CMD 層位置 22
 *   鍵盤滾動   → 這一層
 *
 * ── 為什麼 6 / 7 必須是兩個 index ─────────────────────────────────────
 *
 * 不能合併：input-listener 只認 layer，合併之後觸控板自動升層時就會變成滾動、
 * 游標永遠動不了。也不能讓 7 去 hold 6——ZMK 的 layer state 是沒有 reference
 * counting 的共用 bitmask，temp-layer 的 timeout 會跟手動 hold 互相打架。
 *
 * 位置 10 (P) 是 &to 0：&to 會把目標層以上的所有層一併關掉，是「回到 BASE」
 * 的逃生口。（2026-09-04 之後整份 keymap **已經沒有任何 &tog**——速度鎖定
 * 那四組 combo 和 NAV 的 &tog 14 都刪了——所以沒有層會被 latch 住。唯一還會
 * 「暫時黏住」的是 CMD 位置 37 的 &sl 5，但 sticky layer 打完下一顆就自己
 * 放掉，不需要逃生口。這顆 &to 0 現在純粹是保險。）
 *
 * 拇指 36-41 不需要登記在任何名單裡：toucan-trackpad.dtsi 的
 * excluded-positions 已經留空，語意是「沒有任何鍵能提前結束滑鼠層」，所以動
 * 這裡的 bindings 不用回頭同步那邊。原因見該檔的註解。
 *
 * （這一層跟 SCR± 兩檔的 bindings 以前是用巨集展開共用的，為了
 * keymap-editor 已攤平成字面 bindings——見檔頭速度對照表。）
 */
/*
 * Hold-tap feel, carried over from the .vil's QMK settings.
 *   tapping-term-ms — Vial "Tapping Term"
 *   flavor          — derived from Vial's permissive-hold / mod-tap-interrupt
 *                     flags. If home-row mods misfire, this is the knob:
 *                     "tap-preferred" is the most forgiving, "hold-preferred"
 *                     the most eager. See zmk.dev/docs/keymaps/behaviors/hold-tap
 */
/*
 * ── 鍵盤滾輪的加速度曲線（2026-09-04 才真正啟用）─────────────────────────
 *
 * ⚠️ 先講一個之前踩到的坑：`time-to-max-speed-ms` 在 `acceleration-exponent`
 *    是 0 的時候**完全沒有作用**。ZMK 的 speed() 長這樣
 *    （zmk/app/src/behaviors/behavior_input_two_axis.c）：
 *
 *      if (... || config->time_to_max_speed_ms == 0 || accel_exp == 0) {
 *          return max_speed;      // ← 直接回傳最高速，根本不看 time-to-max
 *      }
 *      return max_speed * powf(time_fraction, accel_exp);
 *
 *    而 ZMK 的 mouse_scroll.dtsi 預設就是 acceleration-exponent = <0>。
 *
 * ⚠️ `&msc` 是**單一節點**，這條曲線 SCRL / SCR- / SCR+ 三檔共用，沒辦法
 *    只給某一檔不同的爬升時間——只有 max（各層寫死的字面數字）能分別調。
 *    這也是慢檔不敢設太低的原因：max 越小，第一格出來得越晚（max=12 要
 *    274ms），會有「按了沒反應」的錯覺。
 *
 * ⚠️ 加速度「放開就歸零」。連續看長文（按住不放）是純賺；半頁半頁地按放
 *    按放則每次都要重跑一次爬升。真的要整頁跳轉，這一層右手底排已經有
 *    M = PgDn、逗號 = PgUp，比硬捲快得多。
 *
 * 想調的話只有兩個旋鈕：這裡的 450（越大越慢熱、加速感越明顯），以及各層
 * 的 max 字面數字（見檔頭對照表）。觸控板不吃這條曲線——它走 input
 * processor，跟 &msc 無關。
 */

&msc {
    // 延遲啟動時間，0 = 隨按隨動

    delay-ms = <0>;

    // 花多少毫秒線性加速到最高速。必須搭配下面的 exponent >= 1 才有意義

    time-to-max-speed-ms = <0>;

    // 1 = 線性加速（速度從 0 開始爬）。設 0 就退回「按下去立刻全速」

    acceleration-exponent = <0>;
};

&mmv {
    // ⚠️ 下面 exponent = 0 ⇒ 這一行不會生效（理由見上面 &msc 的說明）。
    //    留著只是為了改回 exponent >= 1 時不用重查數字。

    time-to-max-speed-ms = <100>;

    // 0 = 一按下去就直接用最高速移動。游標刻意維持等速：加速度用在滾輪上
    // 是「看長文越滾越快」，用在游標上則是每次要點東西都要等它熱身。

    acceleration-exponent = <0>;

    // 延遲啟動時間 (與滾輪相同，設為 0 代表隨按隨動)

    delay-ms = <0>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;

    // 點一下、200ms 內再按住同一鍵 ➜ 連發該鍵的 tap 鍵碼（Enter/BSPC/Space...）
    // 而不是進層。想連發就「點、按住」，想進層就直接長按。

    quick-tap-ms = <200>;
};

&num_word {
    // 包含：退格、刪除、加號、減號、等號、小數點、乘號、除號、字母 x (以及對應的 Numpad 代碼)

    continue-list = <BSPC DEL PLUS KP_PLUS MINUS KP_MINUS EQUAL KP_EQUAL DOT KP_DOT STAR KP_MULTIPLY FSLH KP_DIVIDE X>;
};

/*
 * Trackpad: tap still clicks, tap-and-hold no longer drags.
 *
 * The central intercepts the pad's button events before they reach HID:
 * `zip_button_behaviors` is a stock ZMK input processor that swallows
 * INPUT_BTN_0/1/2 and invokes a behavior instead. Point it at macros, and a
 * macro with no `&macro_pause_for_release` does nothing on release — so a held
 * button becomes a single click and the drag can never start.
 *
 * Consequence, stated plainly: dragging with the pad alone is now impossible.
 * To drag, hold LCLK on layer PAD (left hand, D) and move the pad.
 *
 * This node must appear in EVERY processor chain on the listener — a chain
 * that matches a layer replaces the base chain rather than adding to it, so a
 * chain that omits this re-opens dragging on exactly those layers. See
 * boards/shields/toucan/toucan-trackpad.dtsi.
 *
 * ── 2026-09-03，換成 Azoteq TPS43 之後 ──────────────────────────────────
 *
 * 原本這段的理由是「Cirque Pinnacle 只有 no-taps (DIS_TAP) 一個旋鈕，而它
 * 會把 tap-to-click 和 tap-and-hold 一起關掉，所以是錯的工具」。TPS43 沒有
 * 這個限制——它的手勢是分開的 devicetree flag，`single-tap` 和
 * `press-and-hold`（＝拖曳）可以獨立開關，而 toucan_right.overlay 現在
 * 刻意只開 single-tap / two-finger-tap，沒開 press-and-hold。
 *
 * 那為什麼還留著這個 processor？兩個理由：
 *   1. 它是 pad 點擊實際的路由：BTN_0/1/2 -> &pad_tap_l / _r / _m。
 *      拿掉的話 pad 點擊會直接送原始 HID button，繞過這三個 macro。
 *   2. 感測器層級關掉拖曳是「設定」，這裡是「保險」——兩層都擋著，
 *      日後有人手癢打開 press-and-hold 也不會突然多出拖曳行為。
 */

&zip_button_behaviors { bindings = <&pad_tap_l &pad_tap_r &pad_tap_m>; };

/ {
    behaviors {
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT SEMI>, <&kp COLON>;
        };

        /*
         * PTT 搜推文，NAV 位置 22（原本 z30 / z50 各佔一顆）。
         * 點一下 = z30，連點兩下 = z50。單點要等 200 ms 的 tapping-term
         * 過完才送出——PTT 熱鍵不在乎這半拍。要加第三檔（例如 z100 搜
         * 爆文）就照 z30 再寫一個 macro，bindings 後面補上 <&z100>，
         * 三連點觸發。
         */

        td_ptt: tap_dance_ptt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&z30>, <&z50>;
        };

        /*
         * ── Hint 熱鍵：點一下 = AX、連點兩下 = Vision（2026-09-10）─────────
         *
         * 掛在 CMD(4) 右拇指兩顆（位置 39 / 40）。四組主機端熱鍵是：
         *
         *              單擊（AX / accessibility tree）  雙擊（Vision / CV 備援）
         *   中鍵 40    Ctrl+Win+Space                   Alt+Win+Space
         *   內側 39    Ctrl+Win+Shift+Space             Alt+Win+Shift+Space
         *              └ 無 Shift = 點一次就收          └ Shift = 連續點擊
         *
         * 也就是「Ctrl 管 AX、Alt 管 Vision、Shift 管連不連續」。Vision 只是 AX
         * 標不到東西時的備援，所以放在比較費事的雙擊上。
         *
         * ⚠️ 為什麼「切 Vision」做在韌體而不是主機端：主機端要做「快速連按兩次」
         *    得引入 timing window，第一次按就得等 200ms 才知道是不是雙擊，主線
         *    （AX）會整個變鈍。做在 tap dance 一樣是 200ms，但**只有這兩顆鍵**付
         *    這個代價，而且 Windows 那邊根本做不到 —— Ctrl+Win+Space 是 NeverClick
         *    用 RegisterHotKey 佔的，AHK 連「使用者按了第二下」都看不到。
         *
         * ⚠️ 送出去要有人接（keymap 只負責送封包）：
         *      macOS   Neru（~/.config/neru/config.toml 的 [hotkeys] 四條）
         *      Windows Ctrl+Win+Space / Alt+Win+Space = NeverClick 的兩條全域熱鍵；
         *              Ctrl+Win+Shift+Space = mousemaster 的 ui-hint 連續點擊。
         *              **Alt+Win+Shift+Space（Vision 連續）在 Windows 沒人接** ——
         *              NeverClick 沒有 repeat、mousemaster 沒有 CV，按了不會有反應。
         *              這是工具能力限制，不是 keymap 漏了。
         *
         * ⚠️ 這四組都**不是** OS 內建快捷鍵，但都撞到別人，主機端已各自處理：
         *      macOS   Ctrl+Cmd+Space = 字元檢視器、Alt+Cmd+Space = Spotlight
         *              「在 Finder 中顯示搜尋視窗」→ 使用者確認不需要，直接覆寫
         *      Windows Alt+Win+Space 原本被 PowerToys 命令選擇區佔走
         *              （RegisterHotKey）→ 已清掉它的熱鍵
         *
         * 兩個平台分支送的是**同一組 HID 鍵碼**（Win 鍵 = ⌘ 是同一顆 modifier），
         * 所以這兩個 behavior 不進「平台個人化」名單，**要兩個分支一起改**。
         */

        td_hint: tap_dance_hint {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(LG(SPACE))>, <&kp LA(LG(SPACE))>;
        };

        td_hint_rep: tap_dance_hint_repeat {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(LG(LS(SPACE)))>, <&kp LA(LG(LS(SPACE)))>;
        };
    };

    /*
     * 2026-09-04：這裡原本有一個 conditional_layers 節點（NAV(1) + HJKL(14)
     * ⇒ WHEL(15)，把 NAV 的 hjkl 四格換成滾輪）。整套 HJKL / WHEL 機制已經
     * 連同那兩層一起刪掉——&tog 14 太容易誤觸，而且會 latch 住，回 BASE 之後
     * 得再按一次才解得開。鍵盤滾動請用 SCRL(7)（按住 G / H）。
     */

    macros {
        /*
         * The three pad-click macros. `&macro_tap` presses and releases within
         * tap-ms; nothing is queued for the release, which is the whole point —
         * see the &zip_button_behaviors note at the top of this file.
         */

        pad_tap_l: pad_tap_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp LCLK>;
        };

        pad_tap_r: pad_tap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp RCLK>;
        };

        pad_tap_m: pad_tap_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp MCLK>;
        };

        macro0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp HOME &kp LS(END)>;
        };

        claude: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp L &kp A &kp U &kp D &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        z30: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N3 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        z50: macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N5 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        macro4: macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(SPACE) &kp V>;
        };

        /*
         * Claude Code 的斜線指令。跟 cc_usage / cc_model 一樣，打完直接送出。
         * /clear 會清掉整段對話——不想要自動送出的話，把最後那組
         * <&macro_tap>, <&kp ENTER> 兩行刪掉即可（只打字、不按 Enter）。
         */

        cc_clear: cc_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp C &kp L &kp E &kp A &kp R>,
                <&macro_tap>,
                <&kp ENTER>;
        };

        cc_rename: cc_rename {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp R &kp E &kp N &kp A &kp M &kp E>,
                <&macro_tap>,
                <&kp ENTER>;
        };

        wq: macro_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W &kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_continue: macro_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp O &kp N &kp T &kp I &kp N &kp U &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_usage: macro8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp U &kp S &kp A &kp G &kp E>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO8";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_model: macro9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp M &kp O &kp D &kp E &kp L>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO9";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_effort: macro10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp F &kp F &kp O &kp R &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO10";
        };

        cc_exit: macro11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp X &kp I &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO11";
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            // Hand-added, not from the .vil — see regen.sh.
            // Z + / together, after a brief pause. Unlocks ZMK Studio.

            timeout-ms = <200>;
            require-prior-idle-ms = <500>;
            key-positions = <25 34>;
            bindings = <&studio_unlock>;
        };

        combo_to_nav {
            timeout-ms = <27>;
            key-positions = <31 32>;
            bindings = <&to 1>;

            // KC_M + KC_COMMA → TO(1)：目標一直是 NAV，index 2026-09-09 修回 1
        };

        combo_tmux {
            timeout-ms = <27>;
            key-positions = <27 28>;
            bindings = <&kp LC(SPACE)>;

            // KC_C + KC_V → LCTL(KC_SPACE)
        };

        combo_wq {
            timeout-ms = <27>;
            key-positions = <2 1>;
            bindings = <&wq>;

            // KC_W + KC_Q → M6
        };

        combo_media {
            timeout-ms = <27>;
            key-positions = <7 8>;
            bindings = <&to 4>;

            // KC_U + KC_I → TO(4)
        };

        /*
         * V + B ➔ num_word：自動升起 NUM 層連打數字，打到不在 continue-list
         * 的鍵就自己掉下來（continue-list 在上面的 &num_word 覆寫）。
         *
         * ⚠️ 下面 bindings 的 `2` 是寫死的層 index，keymap-editor **不會**幫它
         *    重編號。2026-09-06 的 fb3fc56（editor bot，訊息寫 "swap ctrl cmd"）
         *    把 NUM 的節點搬到 NAV 前面——層 index 是照 devicetree 的節點順序算
         *    的，不是照 layer_N 的名字——所以 NUM 從 2 變成 1。editor 把它認得的
         *    &lt / &mo / &to 全部跟著改了，卻不知道 &num_word 的參數也是層
         *    index，於是這組 combo 變成升 NAV，症狀就是「num_word 不見了」。
         *    2026-09-09 節點順序修回 NAV, NUM，這一行也跟著回到 2。
         *    以後只要層的順序動過，這一行都要手動核對。
         *    （不能改寫成 #define：editor 的 parser 不吃 bindings 裡的自訂巨集，
         *      見檔頭。）
         */

        combo_num_word {
            timeout-ms = <27>; // 依照你其他 combo 的習慣設定為 27 毫秒
            key-positions = <29 28>; // 對應 BASE 層的 V (28) 和 B (29)
            bindings = <&num_word 2>; // 2 = NUM（節點順序：BASE, NAV, NUM…）
        };

        layer {
            bindings = <&to 7>;
            key-positions = <30 31>;
        };

        /*
         * 2026-09-04：這裡原本有四組 combo_lock_*（拇指兩顆同時按 ⇒ &tog 8 /
         * &tog 10，鎖住觸控板游標的最慢 / 最快檔）。跟著三檔收成兩檔一起刪掉。
         *
         * 刪掉的理由是位置衝突：調速鍵從「36 快 / 37 中 / 38 慢」改成
         * 「37 快 / 38 慢」之後，僅存的兩顆變成相鄰，而 combo_lock_slowest_l
         * 正好就是 <37 38>——拇指從快檔滾到慢檔時只要在 50 ms 內壓到兩顆就會
         * 鎖住，是個標準的 latch 陷阱。
         *
         * 以後要重做的話，建議用空出來的 36 / 41 當「鎖定修飾鍵」：
         *   左手 36+37 鎖快、36+38 鎖慢；右手 41+40 鎖快、41+39 鎖慢。
         * 這樣兩顆調速鍵之間怎麼滾都不會誤觸。
         *
         * 屆時 `layers` 名單一定要含被鎖的那兩層（ZMK 是拿「按下第一顆鍵當下
         * 最高的 active layer」去比對，見 combo.c 的
         * zmk_keymap_highest_layer_active），少了它們鎖上就解不開；而且刻意
         * 不要含 SCRL(7)——鎖住滾動速度是陷阱，放開 G 之後觸控板會在非滾動
         * 狀態持續滾動。
         */
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &mt LALT A  &mt LGUI S  &mt LCTRL D  &mt LSHFT F  &lt 7 G  &lt 7 H  &mt LSHFT J  &mt LCTRL K  &mt LGUI L  &td5  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp LG(SPACE)  &kp FSLH  &none  &lt 3 TAB  &lt 4 SPACE  &lt 1 ESC  &lt 2 BSPC  &lt 5 RET  &lt 3 F19
            >;
        };

        layer_1 {
            display-name = "NAV";

            /*
             * ⚠️ 2026-09-04 更正：這裡原本寫「位置 3 和 4 是手動加的
             *    &studio_unlock / &bootloader」——**那已經不是事實**。
             *    5b6ab49 當年確實把它們放在位置 3/4，但 3860f1b（add macro）
             *    起陸續被 Claude Code 巨集覆蓋，現在是：
             *
             *      0 &none      1 &cc_exit    2 &cc_clear
             *      3 &none      4 &cc_rename  5 &macro4
             *
             *    也就是 **位置 3 是空的**，是這一層唯一的現成空位。
             *
             *    兩條逃生路徑沒有消失，只是搬家了，不用急著補回來：
             *      Studio 解鎖 → combo_studio_unlock（Z + /，見上面 combos）
             *      bootloader → BT(12) 層的 B 和 N 兩顆（見 layer_12 註解）
             *
             *    regen.sh 的 Patch 2 仍然假設位置 0-4 是五顆 &none，所以
             *    重跑 regen 會直接硬錯——那是刻意的，見 regen.sh 檔頭。
             *
             * Position 22 is hand-changed:
             *   22 &td_ptt — z30 / z50 合併：點一下 z30、連點兩下 z50。
             *
             * 位置 29（BASE 的 B）2026-09-11：&claude（打字 claude+Enter）換成
             * &kp LC(LA(SPACE)) ＝ Ctrl+Alt+Space —— herbr 的 prefix，主機端
             * 要有 herbr 在跑才有反應。&claude 巨集比照 Piantor 的 M12/M13
             * 慣例保留不刪（見 piantor/README.md），要回退直接綁回去。
             *
             * 位置 34 以前是 &tog 14（hjkl 方向鍵 ⇄ 滾輪切換）。2026-09-04
             * 連同 HJKL / WHEL 兩層一起刪掉，改成 &trans 落回 BASE 的 `/`。
             * 這顆同時是 combo_studio_unlock 的一半（<25 34>），combo 是看
             * 位置不是看 binding，所以改成 &trans 不影響解鎖。
             */

            bindings = <
&none  &cc_exit  &cc_clear  &none  &cc_rename  &macro4  &kp LC(PG_UP)  &kp LC(PG_DN)  &kp LA(LEFT)  &kp LA(RIGHT)  &to 0  &none  &none  &kp LALT  &kp LGUI  &kp LCTRL  &kp LSHFT  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &td_ptt  &none  &none  &cc_effort  &kp LA(P)  &cc_continue  &cc_usage  &kp LC(LA(SPACE))  &kp END  &kp PG_DN  &kp PG_UP  &kp HOME  &trans  &none  &none  &none  &kp ESC  &kp BSPC  &kp DEL  &kp F19
            >;
        };

        layer_2 {
            display-name = "NUM";

            /*
             * ⚠️ 位置 34（右手小指底排，BASE 的 `/`）是 BT 層的**唯一入口**。
             *
             * 2026-09-09 從 CMD 位置 40（右拇指中鍵）搬過來的——那顆太好按，
             * 讓給 Ctrl+Win+Space。挑這裡的理由：
             *   1. 這一層右手本來整片是 &none（位置 6-9、30-34 全空），
             *      所以佔掉它不會擠掉任何現有鍵，也沒有既有肌肉記憶。
             *   2. 進 NUM 靠的是**右**拇指 BSPC，位置 34 又是右手小指最外側
             *      ⇒ 同手大跨度，打字時絕對不可能誤觸。
             *   3. 按住之後**左手整隻是自由的**，而 BT 層要按的東西剛好都在
             *      左邊：BT_SEL 0-4 在位置 1-5、OUT_USB/BLE/TOG 在 13-15、
             *      BT_CLR 在 25。所以「難按」只針對進入，配對操作不受影響。
             *
             * 完整手勢：按住右拇指 BSPC + 右小指 `/`，左手選 profile。
             * bootloader（位置 29/30）也在這條路徑上，刷機前要記得。
             */

            bindings = <
&none  &kp KP_MULTIPLY  &kp N7  &kp N8  &kp N9  &kp KP_PLUS  &none  &none  &none  &none  &to 0  &none  &none  &kp KP_DIVIDE  &kp N4  &kp N5  &kp N6  &kp MINUS  &none  &kp LSHFT  &kp LCTRL  &kp LGUI  &kp LALT  &none  &none  &kp X  &kp N1  &kp N2  &kp N3  &kp EQUAL  &none  &none  &none  &none  &mo 12  &none  &kp N0  &kp DOT  &kp PRCNT  &kp BACKSPACE  &kp ENTER  &kp F19
            >;
        };

        layer_3 {
            /*
             * SYM 是第一個被縮短的層名（當年只有它超標），現在全部 13 層
             * 都收進 4 字元了——理由見檔頭的層名表。
             *
             * ⚠️ 這一個名字比其他層多兩個綁定：小抄是用「層名字串」查表的，
             * 不是用 index。改成別的字要同步這兩處，否則小抄直接消失：
             *   boards/shields/nice_view_gem/widgets/cheatsheet.c 的 .layer_name
             *   scanner-module/.../src/radii_layout.c 的 CHEAT_LAYER_NAME
             * 所以 SYM 刻意維持原樣。
             */

            display-name = "SYM";
            bindings = <
&none  &kp QMARK  &kp EXCL  &kp LBKT  &kp RBKT  &kp KP_PLUS  &kp AT  &kp HASH  &kp DLLR  &kp DQT  &kp GRAVE  &none  &none  &kp LT  &kp GT  &kp LPAR  &kp RPAR  &kp MINUS  &kp TILDE  &mt LSHFT SQT  &kp LCTRL  &kp LGUI  &mt LALT COLON  &none  &none  &kp PIPE  &kp AMPS  &kp LBRC  &kp RBRC  &kp KP_EQUAL  &kp CARET  &kp STAR  &kp COMMA  &kp BSLH  &kp FSLH  &none  &kp UNDER  &kp DOT  &kp PRCNT  &kp LS(LC(LA(LG(E))))  &kp LA(SPACE)  &kp LC(LG(R))
            >;
        };

        layer_4 {
            display-name = "CMD";

            /*
             * ── 2026-09-09 右拇指兩顆換成主機端全域熱鍵 ──────────────────
             *
             *   位置 39（右拇指最內側）  &mo 2（升 NAV）   → Ctrl+Win+Shift+Space
             *   位置 40（右拇指中鍵）    &mo 12（升 BT）   → Ctrl+Win+Space
             *
             * ── 2026-09-10 這兩顆再升級成 tap dance ──────────────────────
             *   39 = &td_hint_rep   單擊 Ctrl+Win+Shift+Space（AX 連續點擊）
             *                       雙擊 Alt+Win+Shift+Space（Vision 連續點擊）
             *   40 = &td_hint       單擊 Ctrl+Win+Space（AX 單次點擊）
             *                       雙擊 Alt+Win+Space（Vision 單次點擊）
             * 定義與完整理由見檔案上方 behaviors 的 td_hint / td_hint_rep 註解。
             * 代價：單擊要等 200ms 的 tapping-term 過完才送出（同 td_ptt）。
             *
             * 理由是位置划算：這兩顆是右拇指最順的位置，而原本掛的兩個功能
             * 都另有入口——NAV 用左拇指 ESC 就到（而且 CMD 本身是左拇指
             * SPACE 按住的，同手再去升 NAV 本來就彆扭）；BT 一個月用不到
             * 一次，搬到 NUM 位置 34（見 layer_2 的註解）。
             *
             * ⚠️ Ctrl+Win+Space / Ctrl+Win+Shift+Space **不是 OS 內建快捷鍵**，
             *    送出去要有人接：Windows 這邊是 AHK、macOS 是 Hammerspoon /
             *    Raycast。keymap 只負責送封包，主機端沒設就等於沒反應。
             *    兩個平台分支送的是**同一組 HID 鍵碼**（Win 鍵 = ⌘ 是同一顆
             *    modifier），所以這三顆不進「平台個人化」名單，要一起改。
             */

            bindings = <
&none  &kp LA(F4)  &kp LC(W)  &kp LC(E)  &kp LC(Y)  &kp LC(T)  &kp LC(U)  &kp LC(BSPC)  &kp LC(DEL)  &kp LC(K)  &to 0  &none  &none  &mt LALT LC(A)  &mt LGUI LC(S)  &mt LCTRL LC(D)  &mt LSHFT LC(F)  &kp LC(L)  &lt 7 HOME  &kp LC(LEFT)  &kp LC(RIGHT)  &kp END  &kp LC(LS(T))  &none  &none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &kp LS(HOME)  &kp LC(LS(LEFT))  &kp LC(LS(RIGHT))  &kp LS(END)  &kp LC(W)  &none  &kp LS(LC(LA(LG(GRAVE))))  &sl 5  &none  &td_hint_rep  &td_hint  &kp F19
            >;
        };

        layer_5 {
            display-name = "FUN";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp C_VOL_UP  &kp LC(LG(N1))  &kp LC(LG(N2))  &kp LC(LG(N3))  &kp LC(LG(N4))  &kp LG(LS(S))  &none  &none  &kp F11  &kp F4  &kp F5  &kp F6  &kp C_MUTE  &kp LS(LC(LA(LG(Y))))  &kp LSHFT  &kp LCTRL  &kp LGUI  &kp LALT  &none  &none  &kp F10  &kp F1  &kp F2  &kp F3  &kp C_VOL_DN  &kp LS(LC(LA(LG(M))))  &kp LS(LC(LA(LG(A))))  &kp LS(LC(LA(LG(N))))  &kp LS(LC(LA(LG(G))))  &kp LS(LC(LA(LG(O))))  &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp LS(LC(LA(LG(P))))  &none  &kp LS(LC(LA(LG(V))))
            >;
        };

        layer_6 {
            display-name = "PAD";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &trans  &trans  &trans  &to 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &mo 9  &mo 8  &mo 8  &mo 9  &trans
            >;
        };

        layer_7 {
            /*
             * 滾輪按鍵（位置 2/4 與 19/20 的 `&msc MOVE_Y`）方向與觸控板一致，
             * 採 macOS 的 natural（內容跟著手指走）語意，**兩個平台分支相同**。
             * 2026-09-08 之前 Windows 分支這四顆是上下對調的，已統一取消 ——
             * 平台一致優先，改動要兩邊一起做。
             * 觸控板方向在 toucan-trackpad.dtsi 的 INPUT_TRANSFORM_Y_INVERT。
             */
            display-name = "SCRL";
            bindings = <
&trans  &kp LC(PLUS)  &msc MOVE_Y(25)  &mmv MOVE_Y(-500)  &msc MOVE_Y(-25)  &kp LC(R)  &kp LC(PG_UP)  &kp LC(PG_DN)  &kp LA(LEFT)  &kp LA(RIGHT)  &to 0  &trans  &trans  &msc MOVE_X(25)  &mmv MOVE_X(-500)  &mmv MOVE_Y(500)  &mmv MOVE_X(500)  &msc MOVE_X(-25)  &msc MOVE_X(25)  &msc MOVE_Y(25)  &msc MOVE_Y(-25)  &msc MOVE_X(-25)  &kp LC(LS(T))  &trans  &trans  &kp LC(MINUS)  &mkp LCLK  &mkp RCLK  &mkp MCLK  &kp ESC  &kp END  &kp PAGE_DOWN  &kp PAGE_UP  &kp HOME  &kp LC(W)  &trans  &kp LC(N0)  &mo 11  &mo 10  &mo 10  &mo 11  &kp F19
            >;
        };

        layer_8 {
            display-name = "CUR-";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9 {
            display-name = "CUR+";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_10 {
            /* 滾輪按鍵方向同 layer_7（natural），兩個平台分支相同。 */
            display-name = "SCR-";
            bindings = <
&trans  &trans  &msc MOVE_Y(10)  &mmv MOVE_Y(-250)  &msc MOVE_Y(-10)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc MOVE_X(10)  &mmv MOVE_X(-250)  &mmv MOVE_Y(250)  &mmv MOVE_X(250)  &msc MOVE_X(-10)  &msc MOVE_X(10)  &msc MOVE_Y(10)  &msc MOVE_Y(-10)  &msc MOVE_X(-10)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_11 {
            /* 滾輪按鍵方向同 layer_7（natural），兩個平台分支相同。 */
            display-name = "SCR+";
            bindings = <
&trans  &trans  &msc MOVE_Y(40)  &mmv MOVE_Y(-1000)  &msc MOVE_Y(-40)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &msc MOVE_X(40)  &mmv MOVE_X(-1000)  &mmv MOVE_Y(1000)  &mmv MOVE_X(1000)  &msc MOVE_X(-40)  &msc MOVE_X(40)  &msc MOVE_Y(40)  &msc MOVE_Y(-40)  &msc MOVE_X(-40)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_12 {
            display-name = "BT";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &to 0  &none  &none  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &bt BT_CLR  &trans  &trans  &trans  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
