/*
 * beekeeb Toucan (dongle mode) keymap
 *
 * GENERATED by keyboard-manager from beekeeb 36key.vil — do not hand-edit if you
 * intend to regenerate. Change the layout in Vial, re-export, and diff.
 *
 * Read CONVERSION-REPORT.md first: it lists everything that did not map
 * cleanly from QMK to ZMK.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Hold-tap feel, carried over from the .vil's QMK settings.
 *   tapping-term-ms — Vial "Tapping Term"
 *   flavor          — derived from Vial's permissive-hold / mod-tap-interrupt
 *                     flags. If home-row mods misfire, this is the knob:
 *                     "tap-preferred" is the most forgiving, "hold-preferred"
 *                     the most eager. See zmk.dev/docs/keymaps/behaviors/hold-tap
 */

&msc {
    // 每次滾動訊號送出的間隔時間 (預設通常是 10 或 15)
    // 數字越小 ➜ 滾動越快；數字越大 ➜ 滾動越慢

    delay-ms = <0>;

    // 長按時，花多少毫秒加速到最高滾動速度 (預設通常是 300)
    // 數字越小 ➜ 越快達到最高速；設為 0 代表不加速，直接用最高速滾動

    time-to-max-speed-ms = <50>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/*
 * Trackpad: tap still clicks, tap-and-hold no longer drags.
 *
 * The Pinnacle has exactly one knob here — `no-taps` (DIS_TAP) — and it kills
 * tap-to-click and tap-and-hold together, so it is the wrong tool. Instead the
 * dongle intercepts the pad's button events before they reach HID:
 * `zip_button_behaviors` is a stock ZMK input processor that swallows
 * INPUT_BTN_0/1/2 and invokes a behavior instead. Point it at macros, and a
 * macro with no `&macro_pause_for_release` does nothing on release — so a held
 * button becomes a single click and the drag can never start.
 *
 * Consequence, stated plainly: dragging with the pad alone is now impossible.
 * To drag, hold LCLK on layer MOUSE (left hand, D) and move the pad.
 *
 * This node must appear in EVERY processor chain on the listener — a chain
 * that matches a layer replaces the base chain rather than adding to it, so a
 * chain that omits this re-opens dragging on exactly those layers. See
 * boards/shields/toucan/toucan.dtsi.
 */

&zip_button_behaviors { bindings = <&pad_tap_l &pad_tap_r &pad_tap_m>; };

/ {
    behaviors {
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT SEMI>, <&kp COLON>;
        };
    };

    macros {
        /*
         * The three pad-click macros. `&macro_tap` presses and releases within
         * tap-ms; nothing is queued for the release, which is the whole point —
         * see the &zip_button_behaviors note at the top of this file.
         */

        pad_tap_l: pad_tap_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp LCLK>;
        };

        pad_tap_r: pad_tap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp RCLK>;
        };

        pad_tap_m: pad_tap_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&mkp MCLK>;
        };

        macro0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(A) &kp LS(LG(RIGHT))>;
        };

        claude: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp L &kp A &kp U &kp D &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        z30: macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N3 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        z50: macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp LS(Z)>,
                <&macro_tap>,
                <&kp N5 &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        macro4: macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(SPACE) &kp V>;
        };

        macro5: macro_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LC(SPACE) &kp V &kp COMMA &kp S>;
        };

        wq: macro_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp COLON>,
                <&macro_tap>,
                <&kp W &kp Q>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_continue: macro_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp C &kp O &kp N &kp T &kp I &kp N &kp U &kp E>,
                <&macro_tap>,
                <&kp RET>;
        };

        cc_usage: macro8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp U &kp S &kp A &kp G &kp E>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO8";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_model: macro9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp M &kp O &kp D &kp E &kp L>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO9";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        cc_effort: macro10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp F &kp F &kp O &kp R &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO10";
        };

        cc_exit: macro11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp FSLH &kp E &kp X &kp I &kp T>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "MACRO11";
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            // Hand-added, not from the .vil — see regen.sh.
            // Z + / together, after a brief pause. Unlocks ZMK Studio.

            timeout-ms = <200>;
            require-prior-idle-ms = <500>;
            key-positions = <25 34>;
            bindings = <&studio_unlock>;
        };

        combo_0 {
            timeout-ms = <27>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
            layers = <3>;

            // LSFT(KC_9) + LSFT(KC_0) → KC_SPACE
        };

        combo_1 {
            timeout-ms = <27>;
            key-positions = <31 32>;
            bindings = <&to 1>;

            // KC_M + KC_COMMA → TO(1)
        };

        combo_2 {
            timeout-ms = <27>;
            key-positions = <27 28>;
            bindings = <&kp LC(SPACE)>;

            // KC_C + KC_V → LCTL(KC_SPACE)
        };

        combo_3 {
            timeout-ms = <27>;
            key-positions = <2 1>;
            bindings = <&wq>;

            // KC_W + KC_Q → M6
        };

        combo_4 {
            timeout-ms = <27>;
            key-positions = <7 8>;
            bindings = <&to 4>;

            // KC_U + KC_I → TO(4)
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &mt LALT A  &mt LCTRL S  &mt LGUI D  &mt LSHFT F  &lt 1 G  &lt 2 H  &mt LSHFT J  &mt LGUI K  &mt LCTRL L  &td5  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp F18  &kp FSLH  &none  &lt 3 TAB  &lt 4 SPACE  &lt 1 ESC  &lt 2 BSPC  &lt 5 RET  &lt 3 F19
            >;
        };

        layer_1 {
            display-name = "NAV";

            /*
             * Positions 3 and 4 are hand-added (see regen.sh):
             *   &studio_unlock — a second way in if the Z + / combo ever
             *                    stops working. Left thumb ESC + E, and
             *                    the thumb must be held past 200 ms.
             *   &bootloader    — left thumb ESC + R. Saves prying the
             *                    dongle out to double-tap RST on a reflash.
             */

            bindings = <
&none  &cc_exit  &none  &none  &macro5  &macro4  &none  &none  &kp F19  &none  &to 0  &none  &none  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &kp LS(LA(LC(LG(T))))  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &z30  &none  &none  &cc_effort  &cc_model  &cc_continue  &cc_usage  &claude  &kp END  &kp PG_DN  &kp PG_UP  &kp HOME  &z50  &none  &kp TAB  &kp SPACE  &kp ESC  &kp BSPC  &kp ENTER  &kp DEL
            >;
        };

        layer_2 {
            display-name = "NUM";
            bindings = <
&none  &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS  &none  &none  &none  &none  &none  &none  &none  &kp KP_DIVIDE  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS  &none  &kp LSHFT  &kp LGUI  &kp LCTRL  &kp LALT  &none  &none  &kp X  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_EQUAL  &none  &none  &none  &none  &none  &none  &kp KP_N0  &kp KP_DOT  &kp PRCNT  &none  &none  &none
            >;
        };

        layer_3 {
            display-name = "SYMBOL";
            bindings = <
&none  &kp QMARK  &kp EXCL  &kp LBKT  &kp RBKT  &kp KP_PLUS  &kp AT  &kp HASH  &kp DLLR  &kp DQT  &kp GRAVE  &none  &none  &kp LT  &kp GT  &kp LPAR  &kp RPAR  &kp MINUS  &kp TILDE  &mt LSHFT SQT  &kp LGUI  &kp LCTRL  &mt LALT COLON  &none  &none  &kp PIPE  &kp AMPS  &kp LBRC  &kp RBRC  &kp KP_EQUAL  &kp CARET  &kp STAR  &kp COMMA  &kp BSLH  &kp FSLH  &none  &kp UNDER  &kp DOT  &kp PRCNT  &kp LS(LC(LA(LG(E))))  &kp LA(SPACE)  &kp LC(LG(A))
            >;
        };

        layer_4 {
            display-name = "MEDIA";
            bindings = <
&none  &kp LG(Q)  &kp LG(W)  &kp LG(E)  &kp LS(LG(Z))  &kp LG(T)  &kp LC(U)  &kp LC(W)  &kp F19  &kp LC(K)  &to 0  &none  &none  &mt LALT LG(A)  &mt LCTRL LG(S)  &mt LGUI LG(D)  &mt LSHFT LG(F)  &kp LG(L)  &kp LS(LG(LBKT))  &kp LG(LEFT)  &kp LG(RIGHT)  &kp LS(LG(RBKT))  &macro0  &none  &none  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LS(LG(T))  &kp LC(A)  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LC(E)  &kp LG(W)  &none  &kp LS(LC(LA(LG(GRAVE))))  &sl 5  &none  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        layer_5 {
            display-name = "FUN";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp C_VOL_UP  &kp LS(LC(LA(LG(L))))  &kp LS(LC(LA(LG(E))))  &kp LS(LC(LA(LG(F))))  &kp LS(LC(LA(LG(T))))  &kp LS(LG(N5))  &none  &none  &kp F11  &kp F4  &kp F5  &kp F6  &kp C_MUTE  &kp LS(LC(LA(LG(Y))))  &kp LSHFT  &kp LGUI  &kp LCTRL  &kp LALT  &none  &none  &kp F10  &kp F1  &kp F2  &kp F3  &kp C_VOL_DN  &kp LS(LC(LA(LG(M))))  &kp LS(LC(LA(LG(A))))  &kp LS(LC(LA(LG(N))))  &kp LS(LC(LA(LG(G))))  &kp LS(LC(LA(LG(O))))  &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp LS(LC(LA(LG(P))))  &none  &kp LS(LC(LA(LG(V))))
            >;
        };

        /*
         * MOUSE — hand-added, see regen.sh. Switched on automatically while
         * the trackpad is moving, by `&mouse_temp_layer 6 1000` in
         * boards/shields/toucan/toucan.dtsi. It drops again 1 s after the last
         * movement, or as soon as you press a key that is not in that node's
         * `excluded-positions`.
         *
         * Everything is on the LEFT hand on purpose: the trackpad lives on the
         * right half, so the hand that is not on the pad does the clicking.
         *
         * Those excluded positions are the eleven keys bound below (e r t /
         * d f g / c v b, plus the two left thumbs). Move a binding here and you
         * must move the position there, or pressing it switches the layer off
         * under you.
         *
         * Left thumbs, while the pad is in use:
         *   middle (37) — LGUI, so cmd-click is one hand each
         *   right  (38) — hold for half cursor speed; it turns on layer SLOW,
         *                 which the listener watches for. Nothing on the layer
         *                 itself does anything, the layer *being on* is the
         *                 signal.
         * Both replace their base-layer &lt bindings only while MOUSE is up.
         */

        layer_6 {
            display-name = "MOUSE";
            bindings = <
&trans  &kp LS(LG(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &msc MOVE_Y(50)  &msc MOVE_Y(-50)  &kp HOME  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_COMMAND  &mo 7  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PG_DN  &kp PG_UP  &kp END  &trans  &trans  &trans  &trans  &trans  &trans  &kp K_BACK  &kp K_FORWARD  &kp LG(W)  &trans  &trans  &trans
            >;
        };

        /*
         * SLOW — a marker layer, held from MOUSE's right thumb. It binds
         * nothing: `slow_cursor` in boards/shields/toucan/toucan.dtsi keys off
         * `layers = <7>` and swaps the pointer scaler from 250/100 to 125/100,
         * i.e. exactly half. Keep every position &trans so the keys underneath
         * keep working while it is held.
         */

        layer_7 {
            display-name = "SLOW";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
