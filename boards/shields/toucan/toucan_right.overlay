#include "toucan.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/*
 * 右半 = split peripheral，持有實體觸控板感測器。
 *
 * 2026-09-03：Cirque Pinnacle (SPI0) → Azoteq TPS43 (I2C0 @0x74)。
 * 這台是 toucan2，硬體跟 repo 原本 fork 的 toucan1 不同，詳細比較與腳位
 * 對撞表見 config/west.yml 的 zmk_driver_azoteq 那段註解。
 *
 * ⚠️ 不要在這裡把 xiao_i2c 設 disabled——它是 &i2c0 的 label 別名，關掉
 *    等於關掉觸控板的匯流排。（左半才需要關：那邊 spi0 給 nice_view 用，
 *    而 nRF52840 的 SPIM0 / TWIM0 是同一顆周邊，兩者不能並存。）
 */

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
    = <&gpio1 12 GPIO_ACTIVE_HIGH>
    , <&gpio1 11 GPIO_ACTIVE_HIGH>
    , <&gpio0 5 GPIO_ACTIVE_HIGH>
    , <&gpio0 10 GPIO_ACTIVE_HIGH>
    , <&gpio0 4 GPIO_ACTIVE_HIGH>
    , <&gpio0 9 GPIO_ACTIVE_HIGH>
    ;

    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
};

&pinctrl {
    i2c0_azoteq_default: i2c0_azoteq_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 13)>,
                    <NRF_PSEL(TWIM_SCL, 1, 15)>;
            bias-pull-up;
        };
    };

    i2c0_azoteq_sleep: i2c0_azoteq_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 13)>,
                    <NRF_PSEL(TWIM_SCL, 1, 15)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_azoteq_default>;
    pinctrl-1 = <&i2c0_azoteq_sleep>;
    pinctrl-names = "default", "sleep";

    /*
     * 數值基準 = beekeeb/zmk-keyboard-toucan2 的原廠設定（同一塊板子、同一
     * 顆感測器），只有「手勢開關」按這個 repo 既有的設計調整，見下方。
     */
    tps43_trackpad: trackpad@74 {
        compatible = "azoteq,tps43";
        reg = <0x74>;
        status = "okay";

        rst-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
        rdy-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

        /*
         * ── 省電與「碰下去要等多久才動」──────────────────────────────
         *
         * 兩套機制完全獨立，別搞混：
         *
         * (A) ZMK 這一側：`enable-power-management` 讓驅動訂閱 ZMK 的
         *     activity 狀態。**沒設 `idle-sleep` 的話，ZMK IDLE（本 repo
         *     30 秒）不會碰觸控板**，只有 ZMK SLEEP（CONFIG_ZMK_IDLE_SLEEP_
         *     TIMEOUT，本 repo 20 分鐘）才真的 suspend。驅動自己沒有另外
         *     的自動 suspend 計時器。⇒ 平常打字時這一套幾乎不會觸發。
         *
         * (B) 感測器自己的狀態機（**日常感受到的延遲來自這裡**）：
         *       ACTIVE -> IDLE-TOUCH -> IDLE -> LP1 -> LP2
         *     每一階有自己的掃描間隔（report-rate-*），停止觸摸後依
         *     timeout-* 逐階往下掉。**手指放上去到游標會動的最壞延遲，
         *     就等於它當下那一階的 report rate。**
         *
         * 2026-09-03：原本照抄 beekeeb 的 `report-rate-lp2 = <640>`，那是
         * 省電取向——他自己的註解寫得很清楚：640 ms ≈ 55µA，而晶片預設的
         * 160 ms ≈ 174µA。也就是我們把喚醒調成比原廠慢 4 倍，實際用起來
         * 就是「碰了要等一下」。改成 240 ms，落在兩個已知錨點之間：
         *
         *     還要更快 -> 160（＝晶片預設，約 174µA）
         *     還要更省 -> 往 640 調回去（約 55µA）
         *
         * 另外把 timeout-lp1 拉長，延後掉進最慢的 LP2（beekeeb 註解過同一
         * 行，單位是 20 秒；他寫 3=60 秒，晶片預設 1=20 秒）。
         */
        enable-power-management;
        report-rate-lp2 = <240>;   /* 最壞喚醒延遲。160=晶片預設 / 640=最省電 */
        timeout-lp1 = <9>;         /* 9 x 20s = 180s 才掉進 LP2 */
        /* 設了 idle-sleep 會讓 ZMK IDLE（30 秒）就 suspend 觸控板，
         * 省電但「30 秒沒打字就要等醒來」，不建議。 */
        // idle-sleep;

        /*
         * ── 手感 ──────────────────────────────────────────────────────
         * sensitivity        觸控靈敏度 %，binding 預設 100
         * scroll-sensitivity 滾動靈敏度 %，**binding 預設是 50，不是 100**
         *                    ——這行不是冗餘，拿掉行為會變
         * filter-settings    座標濾波。0x0F=全開（最平滑、延遲最高，binding
         *                    預設）/ 0x0B=IIR+MAV+ALP 動態 IIR（平衡，現用）
         *                    / 0x03=只有 IIR+MAV / 0x01=只有 IIR（最低延遲）
         *                    / 0x00=不濾（原始資料，會抖）
         *                    覺得「游標黏黏的、跟不上手」就往 0x03 或 0x01 調。
         * hold-time          press-and-hold 的判定時間（ms）。目前沒開那個
         *                    手勢，所以這行暫時不影響任何行為。
         */
        sensitivity = <100>;
        scroll-sensitivity = <100>;
        filter-settings = <0x0B>;
        hold-time = <500>;

        /*
         * ── 還有這些旋鈕，需要再打開（完整清單見驅動的
         *    dts/bindings/input/azoteq,tps43-common.yaml）──────────────
         *
         * 點擊手感：
         *   tap-time = <ms>          點擊的最長按壓時間
         *   tap-distance = <px>      點擊時容許的最大位移（手抖會誤判成拖曳時調大）
         *
         * 追蹤與解析度：
         *   report-rate-active = <ms>   移動中的回報間隔（越小越跟手、越耗電）
         *   x-resolution / y-resolution 觸控板解析度
         *   filter-dynamic-bottom / -lower / -upper
         *                               低速時的濾波強度與速度門檻，
         *                               「慢慢移很鈍」就是調這組
         *
         * 其他省電階段（⚠️ 晶片預設值未查證，真的不夠再動）：
         *   report-rate-idle / -idle-touch / -lp1
         *   timeout-active / -idle-touch / -idle
         *
         * 手勢細節（要先開對應的手勢才有意義）：
         *   scroll-initial-distance / scroll-angle
         *   zoom-initial-distance / zoom-consecutive-distance / zoom-sensitivity
         *   swipe-initial-distance / -initial-time / -angle
         *   swipe-consecutive-distance / -consecutive-time
         *
         * ATI（自動調校，碰到誤觸或不靈敏才動，動錯會整個壞掉）：
         *   ati-target / ref-drift-limit / reati-lower-limit /
         *   reati-upper-limit / max-count-limit / ati-retry-time /
         *   ref-update-time
         */

        /*
         * ── 方位 ──────────────────────────────────────────────────────
         * 照抄 beekeeb toucan2：感測器是轉過的，沒有 switch-xy 的話 X / Y
         * 會對調。
         *
         * ⚠️ 實機如果方向不對，只有三個旋鈕，依序試：
         *   1. 這裡的 switch-xy（拿掉 = X/Y 不對調）
         *   2. 這裡加 invert-x / invert-y
         *   3. toucan-trackpad.dtsi 各滾動鏈的 INPUT_TRANSFORM_*_INVERT
         *      ——那幾個是當年配合 Cirque 的方位調出來的，換感測器之後
         *      很可能要跟著翻。
         */
        switch-xy;
        invert-scroll-y;

        /*
         * ── 手勢 ──────────────────────────────────────────────────────
         * TPS43 的手勢是「感測器內建」的（devicetree flag 直接進硬體），
         * 不是 ZMK input processor——這跟 Cirque 完全不同，Cirque 那邊
         * 所有手勢都是靠 processor 疊出來的。
         *
         * 目前只開兩個「點擊」，刻意跟這個 repo 既有的設計對齊：
         *
         *   single-tap      點一下 = 左鍵。等同 Cirque 時代的行為，會被
         *                   toucan.keymap 的 &zip_button_behaviors 攔下來
         *                   換成 &pad_tap_l。
         *   two-finger-tap  兩指點 = 右鍵 → &pad_tap_r。Cirque 沒有，
         *                   但語意一致，白賺的。
         *
         * 以下刻意「不」開，理由都在既有設計裡：
         *
         *   press-and-hold  = 按住拖曳。使用者刻意讓「pad 單獨拖曳變成
         *                     不可能」（見 toucan.keymap 檔頭的
         *                     zip_button_behaviors 說明），要拖曳是按住
         *                     PAD 層的 LCLK 再移動。開了會打架。
         *   scroll          = 硬體雙指滾動。這個 repo 的滾動是「層 + 單指
         *                     拖曳 + 三檔調速」（SCRL / SCR- / SCR / SCR+），
         *                     硬體滾動會繞過整套調速設計。想試就打開，
         *                     scroll-angle 一併解註解。
         *   zoom            = 雙指縮放，需要 zmk-input-zoom 的 zip_zoom_mapper
         *                     接在 listener 上（模組已在 west.yml 拉進來）。
         *   three-finger-swipe = 三指滑動切桌面，需要 swipe_button_mapper。
         *
         * 全部都是一行的事，等基本游標確認正常再逐個加。
         */
        single-tap;
        two-finger-tap;
        // press-and-hold;
        // scroll;
        // scroll-angle = <30>;
        // zoom;
        // three-finger-swipe;
        // three-finger-swipe-throttle-ms = <1200>;
    };
};

/*
 * 把感測器綁到 input-split 的 proxy 上。對側（central）那份在
 * toucan-trackpad.dtsi，reg 必須一致（都是 0）。
 */
&trackpad_split {
    device = <&tps43_trackpad>;
};
