#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "toucan-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

    col-gpios
    = <&gpio0 9 GPIO_ACTIVE_HIGH>
    , <&gpio0 4 GPIO_ACTIVE_HIGH>
    , <&gpio0 10 GPIO_ACTIVE_HIGH>
    , <&gpio0 5 GPIO_ACTIVE_HIGH>
    , <&gpio1 11 GPIO_ACTIVE_HIGH>
    , <&gpio1 12 GPIO_ACTIVE_HIGH>
    ;
    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
    };


    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
        // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
        // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
        //                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
                map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /*
     * Auto mouse layer. `zip_temp_layer` turns MOUSE on while the trackpad is
     * moving and off again after the timeout — *or* the moment a key is
     * pressed. That second rule is why `excluded-positions` exists: without
     * it, pressing left-click would switch the layer off in the same instant
     * it is used. The positions below are exactly the keys bound on layer
     * MOUSE in config/toucan.keymap (e r t / d f g / c v b, plus the middle and
     * right left-thumb keys 37 and 38 — all left hand, since the trackpad is on
     * the right half); change one, change the other.
     *
     * `require-prior-idle-ms` stops a palm brushing the pad mid-sentence from
     * flipping the layer under your fingers.
     */
    /omit-if-no-ref/ mouse_temp_layer: mouse_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <150>;
        excluded-positions = <3 4 5 15 16 17 27 28 29 37 38>;
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint_split>;
        /*
         * Cursor and scroll feel are back to the vendor values. 2026-08-08 they
         * were tuned (cursor 150/100, scroll 1/8 then 1/16, inversions removed)
         * and the scroll never came out usable at any of those settings, so the
         * whole feel side was reverted rather than tuned further.
         *
         * What is NOT reverted, because it was asked for separately and is
         * unrelated to feel: `&mouse_temp_layer` below, and layer 4 in the
         * scroller's layer list.
         *
         * Knobs, if this gets revisited:
         *   `zip_xy_scaler <mult> <div>`     — cursor speed, 250/100 = 2.5x
         *   `zip_scroll_scaler <mult> <div>` — scroll speed, bigger divisor is slower
         *   `zip_scroll_transform ...`       — per-axis direction
         * Note macOS applies its own scroll acceleration and "natural
         * scrolling" flip on top of whatever the firmware sends, which is why
         * firmware-side scaling alone never felt right. ZMK v0.3 has no
         * acceleration processor of its own.
         */
        /*
         * `&zip_button_behaviors` goes LAST, and must appear in every chain
         * below as well. It swallows the pad's own button events and taps a
         * click macro instead, which is what stops a resting finger from
         * turning into a held button — see config/toucan.keymap.
         *
         * Every chain: a child whose `layers` match REPLACES this list rather
         * than adding to it (input_listener.c `filter_with_input_config`
         * returns as soon as an override matches). A chain without it drags
         * again on precisely those layers.
         */
        input-processors = <&zip_xy_scaler 250 100 &mouse_temp_layer 6 1000 &zip_button_behaviors>;

        scroller {
            /*
             * Layers where dragging the trackpad scrolls instead of moving the
             * cursor: 1 NAV, 2 NUM, 4 MEDIA (4 was added on request).
             *
             * 6 (MOUSE) is deliberately NOT here. That layer switches itself on
             * whenever the trackpad moves, so listing it would turn every
             * pointer movement into a scroll and the cursor would never move
             * again.
             */
            layers = <1 2 4>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 5
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_button_behaviors
            >;
        };

        /*
         * Half cursor speed while the MOUSE layer's right thumb (position 38)
         * is held — that key is `&mo 7`, and this watches for the layer rather
         * than the key. 125/100 against the base 250/100 is exactly half.
         *
         * The rest of the chain is copied from the base for the reason stated
         * above: this replaces the base list, it does not extend it. Listed
         * after `scroller` on purpose, so that a layer which already means
         * "the pad scrolls" keeps winning.
         */
        slow_cursor {
            layers = <7>;
            input-processors = <&zip_xy_scaler 125 100 &mouse_temp_layer 6 1000 &zip_button_behaviors>;
        };
    };
};
